              </div>
            ))}
          </div>
        </div>
      </section>

      {/* PROJECTS */}
      <section id="projects">
        <Drips color={accent} enabled={tweaks.dripsEnabled}/>
        <div className="section-blood">✦</div>
        <div className="section-inner">
          <div className="section-label reveal">03 — Work</div>
          <h2 className="section-title reveal reveal-delay-1 section-title-gradient">Projects &<br/>Deployments</h2>
          <div className="section-sep reveal reveal-delay-2"></div>
          <div className="projects-grid">
            <div className="project-card featured reveal reveal-delay-1">
              <div className="ripple-container"></div>
              <div className="project-thumb">
                <div className="project-thumb-grid"></div>
                <div className="project-thumb-img">
                  <svg viewBox="0 0 48 48" fill="none">
                    <rect x="6" y="8" width="36" height="32" rx="4" stroke="#ccc" stroke-width="1.2" fill="none"/>
                    <rect x="14" y="14" width="20" height="20" rx="2" stroke="#ccc" stroke-width="0.8" opacity="0.25" fill="none"/>
                    <path d="M14 8V4M24 8V4M34 8V4" stroke="#ccc" stroke-width="1.2" stroke-linecap="round"/>
                    <path d="M8 40V44M24 40V44M40 40V44" stroke="#ccc" stroke-width="1.2" stroke-linecap="round"/>
                    <rect x="10" y="10" width="4" height="4" rx="1" fill="#ccc" opacity="0.15"/>
                    <rect x="18" y="10" width="4" height="4" rx="1" fill="#ccc" opacity="0.15"/>
                    <rect x="26" y="10" width="4" height="4" rx="1" fill="#ccc" opacity="0.15"/>
                    <rect x="34" y="10" width="4" height="4" rx="1" fill="#ccc" opacity="0.15"/>
                  </svg>
                </div>
                <div className="project-thumb-label">
                  <span className="project-icon">⟠</span>
                  RamClean
                </div>
                <div className="project-thumb-dots">
                  <span></span><span></span><span></span>
                </div>
              </div>
              <div className="project-body">
                <div className="project-badge">
                  <span className="project-badge-dot" style={{background:'#ccc'}}></span>
                  Latest Project
                </div>
                <div className="project-tag-row">
                  <span className="project-tag project-tag-csharp">C#</span>
                  <span className="project-tag project-tag-win">WPF</span>
                  <span className="project-tag project-tag-dotnet">.NET 6</span>
                  <span className="project-tag">Windows</span>
                </div>
                <div className="project-name">RamClean</div>
                <p className="project-desc">Lightweight RAM cleaning utility for Windows with real-time monitoring, animated gauge, process manager, auto-clean with threshold, game mode, system optimizations, and a glassmorphism dark theme UI. Built with WPF & .NET 6.</p>
                <div className="project-links">
                  <a href="https://github.com/x1yzl/RamClean" target="_blank" rel="noopener noreferrer" className="project-link">↗ View on GitHub</a>
                  <a href="https://github.com/x1yzl/RamClean/releases" target="_blank" rel="noopener noreferrer" className="project-link">↗ Download</a>
                </div>
              </div>
            </div>
            <div className="project-card reveal reveal-delay-2">
              <div className="ripple-container"></div>
              <div className="project-thumb">
                <div className="project-thumb-grid"></div>
                <div className="project-thumb-img">
                  <svg viewBox="0 0 48 48" fill="none">
                    <rect x="6" y="10" width="36" height="26" rx="3" stroke="#ccc" stroke-width="1.2" fill="none"/>
                    <rect x="10" y="14" width="28" height="18" rx="1" stroke="#ccc" stroke-width="0.6" opacity="0.2" fill="none"/>
                    <path d="M18 36v6M30 36v6" stroke="#ccc" stroke-width="1.2" stroke-linecap="round"/>
                    <path d="M12 42h24" stroke="#ccc" stroke-width="1.2" stroke-linecap="round"/>
                    <path d="M14 18h4v4h-4zM20 18h4v4h-4zM26 18h4v4h-4z" fill="#ccc" opacity="0.12"/>
                    <path d="M14 24h12v2H14z" fill="#ccc" opacity="0.12"/>
                  </svg>
                </div>
                <div className="project-thumb-label">
                  <span className="project-icon">⌬</span>
                  Portfolio v1
                </div>
              </div>
              <div className="project-body">
                <div className="project-tag-row">
                  <span className="project-tag">HTML</span>
                  <span className="project-tag">CSS</span>
                  <span className="project-tag">React</span>
                </div>
                <div className="project-name">Portfolio v1</div>
                <p className="project-desc">My first real portfolio. Scrapped it eventually but learned a lot building it. The bones were solid, the design not so much.</p>
                <div className="project-links">
                  <a href="https://github.com/x1yzl/x1yzl.github.io" target="_blank" rel="noopener noreferrer" className="project-link">↗ View</a>
                </div>
              </div>
            </div>
            <div className="project-card reveal reveal-delay-3">
              <div className="ripple-container"></div>
              <div className="project-thumb">
                <div className="project-thumb-grid"></div>
                <div className="project-thumb-img">
                  <svg viewBox="0 0 48 48" fill="none">
                    <path d="M24 4L44 16V32L24 44L4 32V16L24 4Z" stroke="#ccc" stroke-width="1.2" fill="none"/>
                    <path d="M24 12L36 19V31L24 38L12 31V19L24 12Z" fill="#ccc" opacity="0.08"/>
                    <text x="24" y="28" text-anchor="middle" fill="#ccc" font-size="10" font-family="monospace" font-weight="700" opacity="0.6">GF</text>
                  </svg>
                </div>
                <div className="project-thumb-label">
                  <span className="project-icon">⟡</span>
                  GorillaFang
                </div>
                <div className="project-thumb-dots">
                  <span></span><span></span><span></span>
                </div>
              </div>
              <div className="project-body">
                <div className="project-badge">
                  <span className="project-badge-dot live"></span>
                  Live
                </div>
                <div className="project-tag-row">
                  <span className="project-tag">3D Rendering</span>
                  <span className="project-tag">Arch. Viz</span>
                  <span className="project-tag">Motion Graphics</span>
                  <span className="project-tag">CGI</span>
                </div>
                <div className="project-name">GorillaFang</div>
                <p className="project-desc">High-level visual engineering. CGI and cinematic animation for brands that don't settle. 3D Rendering, Architectural Visualization, Motion Graphics, Animation, AV Production and CGI Design.</p>
                <div className="project-links">
                  <a href="https://gorillafang.com/" target="_blank" rel="noopener noreferrer" className="project-link">↗ View Site</a>
                </div>
              </div>
            </div>
          </div>
          <ShowMoreBtn/>
        </div>
      </section>

      {/* SERVICES */}
      <section id="services">
        <div className="section-blood alt">❖</div>
        <div className="section-inner">
          <div className="section-label reveal">04 — Offering</div>
          <h2 className="section-title reveal reveal-delay-1">Services</h2>
          <div className="section-sep reveal reveal-delay-2"></div>
          <div className="services-grid">
            {services.map((s,i)=>(
              <div key={s.num} className={`service-card reveal reveal-delay-${(i%4)+1}`}>
                <div className="service-card-corner tl"></div>
                <div className="service-card-corner br"></div>
                <div className="service-num">{s.num}</div>
                <div className="service-name">{s.name}</div>
                <div className="service-desc">{s.desc}</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* CONTACT */}
      <section id="contact">
        <div className="section-blood">⬩</div>
        <div className="section-inner contact-inner">
          <div className="section-label reveal" style={{justifyContent:'center'}}>05 — Reach Out</div>
          <h2 className="section-title reveal reveal-delay-1" style={{textAlign:'center'}}>Begin a<br/>Collaboration</h2>
          <div className="section-sep reveal reveal-delay-2" style={{margin:'0 auto 2rem'}}></div>
          <p className="contact-subtitle reveal reveal-delay-3">
            Got something you want to build? Or just want to talk shop? Either way, hit me up. I'm open to freelance work, collabs, and interesting problems.
          </p>
          <div className="reveal reveal-delay-3 contact-dc-btn">
            <button
              className="btn-primary"
              onClick={() => setDcModalOpen(true)}
            >
              <svg viewBox="0 0 127.14 96.36" xmlns="http://www.w3.org/2000/svg" style={{width:16,height:16,fill:'currentColor',flexShrink:0}}>
                <path d="M107.7 8.07A105.15 105.15 0 0 0 81.47 0a72.06 72.06 0 0 0-3.36 6.83 97.68 97.68 0 0 0-29.11 0A72.37 72.37 0 0 0 45.64 0a105.89 105.89 0 0 0-26.25 8.09C2.79 32.65-1.71 56.6.54 80.21a105.73 105.73 0 0 0 32.17 16.15 77.7 77.7 0 0 0 6.89-11.11 68.42 68.42 0 0 1-10.85-5.18c.91-.66 1.8-1.34 2.66-2a75.57 75.57 0 0 0 64.32 0c.87.71 1.76 1.39 2.66 2a68.68 68.68 0 0 1-10.87 5.19 77 77 0 0 0 6.89 11.1 105.25 105.25 0 0 0 32.19-16.14c2.64-27.38-4.51-51.11-18.9-72.15zM42.45 65.69C36.18 65.69 31 60 31 53s5-12.74 11.43-12.74S54 46 53.89 53s-5.05 12.69-11.44 12.69zm42.24 0C78.41 65.69 73.25 60 73.25 53s5-12.74 11.44-12.74S96.23 46 96.12 53s-5.04 12.69-11.43 12.69z"/>
              </svg>
              Send a Message
            </button>
          </div>
          {dcModalOpen && (
            <DiscordModal
              onAccept={() => setDcModalOpen(false)}
              onReject={() => setDcModalOpen(false)}
            />
          )}
          <div className="contact-links reveal reveal-delay-4">
            <a href="https://github.com/x1yzl" className="contact-link" target="_blank" rel="noopener noreferrer">↗ GitHub</a>
            <span className="contact-separator">◆</span>
            <a href="mailto:x1yzl@proton.me" className="contact-link" target="_blank" rel="noopener noreferrer">↗ Email</a>
          </div>
