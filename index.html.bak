        <ellipse cx="47" cy="447" rx="20" ry="4" fill="#888" opacity="0.25"/>
      </svg>
    </div>
  );
}

// ── MAIN APP ──
function App() {
  const { useTweaks, TweaksPanel, TweakSection, TweakColor, TweakSlider, TweakToggle } = window;
  const [tweaks, setTweak] = useTweaks(TWEAK_DEFAULTS);
  const accent = tweaks.accentColor;
  const canvasRef = useRef(null);

  useEffect(()=>{
    // set CSS var
    document.documentElement.style.setProperty('--accent', accent);
    document.documentElement.style.setProperty('--accent-dim', accent);
    document.documentElement.style.setProperty('--accent-glow', accent);
  },[accent]);

  useEffect(()=>{
    const engine = initCanvas(accent);
    engine.init(tweaks.particleCount);
    engine.start();
    return ()=>engine.stop();
  },[accent, tweaks.particleCount]);

  useEffect(()=>{
    initReveal();
    // ── 3D TILT ON PROJECT CARDS ──
    const tiltCards = () => {
      const cards = document.querySelectorAll('.project-card');
      cards.forEach(card => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = (e.clientX - rect.left) / rect.width - 0.5;
          const y = (e.clientY - rect.top) / rect.height - 0.5;
          card.style.setProperty('--rx', (y * -8) + 'deg');
          card.style.setProperty('--ry', (x * 8) + 'deg');
          card.style.setProperty('--rz', (Math.abs(x) + Math.abs(y)) * 1.5 + 4 + 'px');
        });
        card.addEventListener('mouseleave', () => {
          card.style.setProperty('--rx', '0deg');
          card.style.setProperty('--ry', '0deg');
          card.style.setProperty('--rz', '0px');
        });
        // ── RIPPLE ON CLICK ──
        card.addEventListener('click', (e) => {
          const container = card.querySelector('.ripple-container');
          if (!container) return;
          const rect = card.getBoundingClientRect();
          const ripple = document.createElement('span');
          ripple.className = 'ripple';
          const size = Math.max(rect.width, rect.height);
          const x = e.clientX - rect.left - size/2;
          const y = e.clientY - rect.top - size/2;
          ripple.style.width = ripple.style.height = size + 'px';
          ripple.style.left = x + 'px';
          ripple.style.top = y + 'px';
          container.appendChild(ripple);
          ripple.addEventListener('animationend', () => ripple.remove());
        });
      });
    };
    tiltCards();
    // ── TYPEWRITER EFFECT ──
    const tagline = document.querySelector('.hero-tagline');
    if (tagline) {
      const original = 'Developer  ·  Designer  ·  Still Learning';
      tagline.textContent = '';
      const cursor = document.createElement('span');
      cursor.className = 'tw-cursor';
      tagline.appendChild(cursor);
      let i = 0;
      const tw = setInterval(() => {
        cursor.before(document.createTextNode(original[i]));
        i++;
        if (i >= original.length) { clearInterval(tw); cursor.style.animation = 'blink 1.2s step-end infinite'; }
      }, 42);
    }
    // ── MOBILE NAV: close on link click ──
    document.querySelectorAll('.nav-links a').forEach(a => {
      a.addEventListener('click', () => {
        document.querySelector('nav').classList.remove('nav-open');
      });
    });
    // ── SCROLL PROGRESS + NAV SHADOW ── (RAF-throttled, cached DOM)
    const nav = document.querySelector('nav');
    const bar = document.getElementById('scroll-progress');
    const aura = document.querySelector('.hero-aura');
    const katana = document.querySelector('.katana-hero');
    const bodyH = document.body;
    let scrollRaf = -1;
    let lastSy = -1;
    let scrollTimeout;
    const onScroll = () => {
      // Disable katana animations during scroll
      if (katana) { katana.style.pointerEvents = 'none'; katana.classList.add('scrolling'); }
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        if (katana) { katana.style.pointerEvents = ''; katana.classList.remove('scrolling'); }
      }, 150);
      if (scrollRaf !== -1) return;
      scrollRaf = requestAnimationFrame(() => {
        scrollRaf = -1;
        const sy = window.scrollY;
        if (sy === lastSy) return;
        lastSy = sy;
        // Scroll progress bar
        if (bar) {
          const h = bodyH.scrollHeight - window.innerHeight;
          bar.style.transform = `scaleX(${Math.min(1, h > 0 ? sy / h : 0)})`;
        }
        // Nav shadow
        if (nav) {
          nav.style.boxShadow = sy > 60
            ? '0 4px 30px rgba(0,0,0,0.5), 0 1px 0 rgba(180,180,180,0.15)'
            : 'none';
        }
        // Parallax hero aura
        if (aura && sy < window.innerHeight) {
          const pct = sy / window.innerHeight;
          aura.style.transform = `translate(-50%, calc(-50% + ${pct * 40}px)) scale(${1 + pct * 0.2})`;
        }
      });
    };
    window.addEventListener('scroll', onScroll, {passive: true});
    return () => {
      window.removeEventListener('scroll', onScroll);
      if (scrollRaf !== -1) cancelAnimationFrame(scrollRaf);
      clearTimeout(scrollTimeout);
    };
  },[]);

  const [activeSection, setActiveSection] = useState('');
  const [dcModalOpen, setDcModalOpen] = useState(false);

  useEffect(()=>{
    const sections = document.querySelectorAll('section[id]');
    const io = new IntersectionObserver(entries=>{
      entries.forEach(e=>{ if(e.isIntersecting) setActiveSection(e.target.id); });
    },{threshold:0.4});
    sections.forEach(s=>io.observe(s));
    return ()=>io.disconnect();
  },[]);

  const navItems = [
    {id:'about',label:'About'},
    {id:'skills',label:'Skills'},
    {id:'projects',label:'Projects'},
    {id:'services',label:'Services'},
    {id:'contact',label:'Contact'},
  ];

  const skills = [
    {cat:'Frontend & Web', icon:'⬡', items:[
      {name:'React / Next.js',pct:92},
      {name:'TailwindCSS',pct:90},
      {name:'TypeScript',pct:82},
      {name:'HTML / CSS',pct:95},
    ]},
    {cat:'Desktop & Systems', icon:'♢', items:[
      {name:'C# / .NET',pct:70},
      {name:'WPF / XAML',pct:72},
      {name:'WinAPI / P/Invoke',pct:65},
      {name:'System Optimization',pct:78},
    ]},
    {cat:'Backend', icon:'◈', items:[
      {name:'Node.js / Express',pct:85},
      {name:'MySQL / PostgreSQL',pct:78},
      {name:'REST API Design',pct:88},
      {name:'System Architecture',pct:72},
    ]},
    {cat:'Design & GFX', icon:'✦', items:[
      {name:'Figma',pct:90},
      {name:'UI/UX Systems',pct:85},
      {name:'Three.js / WebGL',pct:60},
      {name:'Motion Design',pct:70},
    ]},
  ];

  const services = [
    {num:'I',name:'Web Development',desc:'Frontend or full-stack, whatever the project needs. I work mainly with React and Next.js but I can adapt.'},
    {num:'II',name:'UI/UX Design',desc:'I design interfaces that make sense. Not just pretty — actually usable, with real thought behind the layout and flow.'},
    {num:'III',name:'Backend & APIs',desc:'Node, Express, MySQL. I can set up a solid API from scratch or clean up one that got out of hand.'},
    {num:'IV',name:'Design Systems',desc:"If your team keeps reinventing the same components, I can build something consistent you can actually reuse."},
    {num:'V',name:'3D / WebGL',desc:'Basic to intermediate Three.js work. Good for landing pages, portfolios, or anything that needs something different.'},
    {num:'VI',name:'Code Review',desc:"I can look at your codebase and tell you honestly what's working and what isn't. No fluff."},
  ];

  return (
    <>
      {/* NAV */}
      <nav>
        <a href="#hero" className="nav-logo">x1yzl</a>
        <ul className="nav-links">
          {navItems.map(n=>(
