      </section>

      {/* FOOTER */}
      <footer>
        <div className="footer-copy">© 2026 x1yzl — All Rights Reserved</div>
        <div className="footer-blood">Developer · Apprentice · Forever Learning</div>
      </footer>

      {/* TWEAKS */}
      <TweaksPanel>
        <TweakSection title="Appearance">
          <TweakColor label="Accent Color" tweakKey="accentColor" />
        </TweakSection>
        <TweakSection title="Particles">
          <TweakSlider label="Particle Count" tweakKey="particleCount" min={10} max={150} step={5}/>
        </TweakSection>
        <TweakSection title="Effects">
          <TweakToggle label="Glitch Text" tweakKey="glitchEnabled"/>
          <TweakToggle label="Blood Drips" tweakKey="dripsEnabled"/>
          <TweakToggle label="Cursor Trail" tweakKey="cursorTrailEnabled"/>
          <TweakToggle label="Floating Runes" tweakKey="runesEnabled"/>
        </TweakSection>
      </TweaksPanel>
    </>
  );
}

function waitForTweaks(cb, attempts = 0) {
  if (window.useTweaks) { cb(); return; }
  if (attempts > 50) { console.error('tweaks-panel never loaded'); cb(); return; }
  setTimeout(() => waitForTweaks(cb, attempts + 1), 50);
}

waitForTweaks(() => {
  ReactDOM.createRoot(document.getElementById('app')).render(<App/>);
});
</script>

</body>
</html>
