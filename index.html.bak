              </div>
              <div className="stat-card">
                <span className="stat-icon">⬡</span>
                <span className="stat-number">15+</span>
                <span className="stat-label">Projects Shipped</span>
              </div>
              <div className="stat-card">
                <span className="stat-icon">⧖</span>
                <span className="stat-number">∞</span>
                <span className="stat-label">Iterations</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* SKILLS */}
      <section id="skills">
        <div className="section-blood">✠</div>
        <div className="section-inner">
          <div className="section-label reveal">02 — Arsenal</div>
          <h2 className="section-title reveal reveal-delay-1">Skills &<br/>Tech Stack</h2>
          <div className="section-sep reveal reveal-delay-2"></div>
          <div className="skills-grid">
            {skills.map((cat,ci)=>(
              <div key={cat.cat} className={`skill-category reveal reveal-delay-${ci+1}`}>
                <div className="skill-cat-title">
                  <span>{cat.icon}</span> {cat.cat}
