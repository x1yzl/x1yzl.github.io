<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>x1yzl — Developer & Apprentice</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Cinzel:wght@400;600;700&family=Share+Tech+Mono&family=IM+Fell+English:ital@0;1&display=swap" rel="stylesheet" />

<script src="https://unpkg.com/react@18.3.1/umd/react.development.js" integrity="sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L" crossorigin="anonymous"></script>
<script src="https://unpkg.com/react-dom@18.3.1/umd/react-dom.development.js" integrity="sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm" crossorigin="anonymous"></script>
<script src="https://unpkg.com/@babel/standalone@7.29.0/babel.min.js" integrity="sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y" crossorigin="anonymous"></script>

<style>
  :root {
    --accent: #e0e0e0;
    --accent-dim: #999;
    --accent-glow: #ffffff;
    --ink: #040305;
    --ink-mid: #07050a;
    --ink-light: #121015;
    --parchment: #d6cfc8;
    --parchment-dim: #888;
    --ash: #333;
    --bone: #f0ece6;
    --gray-border: #2a2a2a;
    --gray-border-light: #3a3a3a;
    --gray-surface: #141414;
    --gray-hover: #222;
    --font-display: 'Cinzel Decorative', serif;
    --font-serif: 'Cinzel', serif;
    --font-mono: 'Share Tech Mono', monospace;
    --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; scroll-padding-top: 80px; }

  body {
    background-color: var(--ink);
    color: var(--bone);
    font-family: var(--font-body);
    overflow-x: hidden;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3CfeColorMatrix type='saturate' values='0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23g)' opacity='0.03'/%3E%3C/svg%3E");
  }

  ::selection { background: rgba(180,180,180,0.4); color: #fff; }

  /* ── NOISE / SCANLINE OVERLAY ── */
  .noise-overlay {
    position: fixed; inset: 0; z-index: 9999;
    pointer-events: none;
    opacity: 0.018;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 256px 256px;
    mix-blend-mode: overlay;
  }
  .scanline-overlay {
    position: fixed; inset: 0; z-index: 9998;
    pointer-events: none;
    opacity: 0.025;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 1px,
      rgba(0,0,0,0.25) 1px,
      rgba(0,0,0,0.25) 2px
    );
  }

  /* RIPPLE EFFECT */
  .ripple-container {
    position: absolute; inset: 0; overflow: hidden;
    pointer-events: none; border-radius: inherit; z-index: 10;
  }
  .ripple {
    position: absolute;
    border-radius: 50%;
    background: rgba(180,180,180,0.4);
    transform: scale(0);
    animation: rippleAnim 0.8s ease-out forwards;
    pointer-events: none;
  }
  @keyframes rippleAnim {
    to { transform: scale(5); opacity: 0; }
  }

  /* ── CANVAS BACKGROUND ── */
  #bg-canvas {
    position: fixed; inset: 0; z-index: 0;
    pointer-events: none;
  }

  /* ── NOISE OVERLAY ── */
  .noise-overlay {
    position: fixed; inset: 0; z-index: 1; pointer-events: none;
    opacity: 0.07;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 180px 180px;
    animation: noiseShift 0.4s steps(2) infinite;
  }
  @keyframes noiseShift { 0%{background-position:0 0} 50%{background-position:40px 25px} 100%{background-position:0 0} }

  /* ── VIGNETTE ── */
  .vignette {
    position: fixed; inset: 0; z-index: 2; pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 25%, rgba(0,0,0,0.92) 100%);
  }

  /* ── MAIN LAYOUT ── */
  #app { position: relative; z-index: 3; }

  /* ── SCROLL PROGRESS BAR ── */
  #scroll-progress {
    position: fixed; top: 0; left: 0; right: 0; height: 2px;
    z-index: 200;
    background: linear-gradient(90deg, var(--accent), #888);
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 0.1s linear;
    box-shadow: 0 0 12px rgba(180,180,180,0.5), 0 0 24px rgba(200,168,78,0.2);
  }

  /* ── NAVIGATION ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between;
    padding: 1rem 4rem;
    border-bottom: 1px solid rgba(180,180,180,0.15);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    background: rgba(4,3,5,0.75);
    transition: background 0.3s, backdrop-filter 0.3s, box-shadow 0.3s;
  }
  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: #d0c8c0;
    letter-spacing: 0.1em;
    text-shadow: 0 0 30px rgba(180,180,180,0.6), 0 0 60px rgba(80,80,80,0.4);
    text-decoration: none;
    transition: all 0.3s;
    position: relative;
  }
  .nav-logo::after {
    content: '//';
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--accent);
    position: absolute; bottom: -8px; right: -18px;
    opacity: 0.6;
  }
  .nav-logo:hover { color: var(--bone); text-shadow: 0 0 50px rgba(180,180,180,0.8), 0 0 100px rgba(80,80,80,0.5); }
  .nav-links {
    display: flex; gap: 2rem; list-style: none;
  }
  .nav-links li { position: relative; }
  .nav-links li::before {
    content: '';
    position: absolute; bottom: -6px; left: 0; right: 0;
    height: 2px; background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.3s;
    border-radius: 1px;
    will-change: transform;
  }
  .nav-links li:hover::before,
  .nav-links li.active::before { transform: scaleX(1); }
  .nav-links li.active-link::before { transform: scaleX(1); }
  .nav-links a {
    font-family: var(--font-serif);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #7a7470;
    text-decoration: none;
    transition: color 0.3s;
  }
  .nav-links a:hover { color: #e0dbd5; text-shadow: 0 0 20px rgba(180,180,180,0.6); }
  .nav-links a.active-link { color: #e0dbd5; text-shadow: 0 0 20px rgba(180,180,180,0.4); }
  .nav-links li.active-link::before { left: 0; right: 0; }
  .nav-toggle {
    display: none; flex-direction: column; gap: 4px;
    background: none; border: none; padding: 4px; cursor: pointer;
  }
  .nav-toggle span {
    display: block; width: 22px; height: 1.5px;
    background: #8a8480; transition: all 0.3s;
    border-radius: 1px;
  }
  .nav-open .nav-toggle span:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
  .nav-open .nav-toggle span:nth-child(2) { opacity: 0; }
  .nav-open .nav-toggle span:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

  /* ── AMBIENT PARTICLES ── */
  .hero-particles {
    position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0;
  }
  .hero-particle {
    position: absolute;
    width: var(--ps, 2px); height: var(--ps, 2px);
    background: var(--accent);
    border-radius: 50%;
    opacity: 0;
    animation: particleDrift var(--pdur, 6s) var(--pdelay, 0s) ease-in-out infinite;
    filter: blur(var(--pblur, 0));
  }
  @keyframes particleDrift {
    0%   { transform: translate(0, 0) scale(0); opacity: 0; }
    10%  { opacity: var(--pop, 0.4); }
    90%  { opacity: var(--pop, 0.4); }
    100% { transform: translate(var(--px, 100px), var(--py, -100px)) scale(1); opacity: 0; }
  }

  /* ── HERO ── */
  #hero {
    min-height: 100vh;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center;
    padding: 8rem 2rem 9rem;
    position: relative;
    overflow: hidden;
  }
  .hero-sigil {
    width: 200px; height: 200px;
    margin-bottom: 2rem;
    position: relative;
    animation: sigilSpin 25s linear infinite;
    filter: drop-shadow(0 0 30px rgba(180,180,180,0.2));
  }
  @keyframes sigilSpin { to { transform: rotate(360deg); } }
  .hero-sigil-inner {
    position: absolute; inset: 14px;
    animation: sigilSpin 12s linear infinite reverse;
  }
  .hero-eyeline {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.4em;
    color: #999;
    text-transform: uppercase;
    margin-bottom: 1rem;
    opacity: 0;
    animation: rv-drop 1s 0.2s cubic-bezier(0.16,1,0.3,1) forwards;
  }
  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(4rem, 10vw, 9rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: 0.03em;
    color: #f5f0ea;
    text-shadow:
      0 0 80px rgba(180,180,180,0.35),
      0 4px 0 rgba(0,0,0,0.95),
      0 0 140px rgba(80,80,80,0.2),
      0 0 200px rgba(180,180,180,0.1);
    opacity: 0;
    animation: rv-flip 1.2s 0.4s cubic-bezier(0.16,1,0.3,1) forwards;
    position: relative;
    backface-visibility: hidden;
  }
  .hero-name .glitch-text { display: inline-block; }
  .hero-tagline {
    font-family: var(--font-mono);
    font-size: clamp(0.8rem, 1.6vw, 1rem);
    color: #a09890;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    margin-top: 1.5rem;
    min-height: 2em;
    display: flex; align-items: center; justify-content: center; gap: 0.2em;
    opacity: 0;
    animation: rv-right 1s 0.65s cubic-bezier(0.16,1,0.3,1) forwards;
  }
  .hero-tagline .tw-cursor {
    display: inline-block;
    width: 0.6em; height: 1.2em;
    background: var(--accent);
    animation: blink 0.8s step-end infinite;
    margin-left: 0.15em;
    vertical-align: middle;
  }
  @keyframes blink { 50% { opacity: 0; } }
  .hero-divider {
    width: 240px; height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    margin: 2rem auto;
    opacity: 0;
    animation: rv-expand 0.9s 0.85s cubic-bezier(0.16,1,0.3,1) forwards;
  }
  .hero-desc {
    max-width: 540px;
    font-size: 1.05rem;
    line-height: 2;
    color: #c8c4be;
    font-style: italic;
    opacity: 0;
    animation: rv-rise 1s 1s cubic-bezier(0.16,1,0.3,1) forwards;
    position: relative;
  }
  .hero-desc::before { content: '"'; color: var(--accent); font-size: 2rem; position: absolute; left: -1.5rem; top: -0.5rem; opacity: 0.5; }
  .hero-desc::after { content: '"'; color: var(--accent); font-size: 2rem; position: absolute; right: -1.5rem; bottom: -0.5rem; opacity: 0.5; }
  .hero-ctas {
    display: flex; gap: 1.5rem; margin-top: 3rem;
    opacity: 0;
    animation: rv-pop 1.05s 1.2s cubic-bezier(0.16,1,0.3,1) forwards;
    flex-wrap: wrap; justify-content: center;
  }

  /* ── 3D KEYFRAMES ── */
  @keyframes fadeIn { from { opacity:0; } to { opacity:1; } }

  @keyframes rv-rise {
    from { opacity:0; transform: perspective(900px) translateY(70px)  rotateX(-22deg); }
    to   { opacity:1; }
  }
  @keyframes rv-drop {
    from { opacity:0; transform: perspective(900px) translateY(-55px) rotateX(30deg) scale(0.94); }
    to   { opacity:1; }
  }
  @keyframes rv-left {
    from { opacity:0; transform: perspective(900px) translateX(-90px) rotateY(38deg); }
    to   { opacity:1; }
  }
  @keyframes rv-right {
    from { opacity:0; transform: perspective(900px) translateX(90px)  rotateY(-38deg); }
    to   { opacity:1; }
  }
  @keyframes rv-flip {
    from { opacity:0; transform: perspective(700px) rotateX(-85deg) translateY(50px) scale(0.88); }
    65%  {            transform: perspective(700px) rotateX(7deg)   translateY(-7px) scale(1.02); }
    to   { opacity:1; }
  }
  @keyframes rv-pop {
    from { opacity:0; transform: perspective(900px) scale(0.65) rotateY(25deg) rotateX(20deg); }
    65%  {            transform: perspective(900px) scale(1.05) rotateY(-3deg) rotateX(-3deg);  }
    to   { opacity:1; }
  }
  @keyframes rv-spin-in {
    from { opacity:0; transform: perspective(900px) translateY(60px) rotateZ(-16deg) rotateX(-28deg) scale(0.80); }
    70%  {            transform: perspective(900px) translateY(-7px)  rotateZ(2deg)  rotateX(3deg)   scale(1.02); }
    to   { opacity:1; }
  }
  @keyframes rv-expand {
    from { opacity:0; transform: perspective(900px) scaleX(0)   rotateY(-25deg); }
    to   { opacity:1; }
  }

  /* ── SCROLL INDICATOR ── */
  .scroll-indicator {
    position: absolute; bottom: 2.5rem; left: 50%;
    transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
    opacity: 0;
    animation: fadeIn 1s 2s forwards;
  }
  .scroll-indicator span {
    font-family: var(--font-mono); font-size: 0.5rem;
    letter-spacing: 0.3em; color: #888; text-transform: uppercase;
  }
  .scroll-line {
    width: 1px; height: 50px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
    position: relative;
  }
  .scroll-line::after {
    content: '';
    position: absolute; bottom: -3px; left: 50%;
    transform: translateX(-50%);
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid var(--accent);
    animation: scrollPulse 2s ease-in-out infinite;
  }
  @keyframes scrollPulse { 0%,100%{opacity:0.4;transform:scaleY(0.8)} 50%{opacity:1;transform:scaleY(1.2)} }
  .scroll-chevrons {
    display: flex; flex-direction: column; align-items: center; gap: -2px;
    margin-top: -4px;
  }
  .scroll-chevron {
    width: 0; height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid rgba(180,180,180,0.4);
    animation: chevronBounce 1.8s ease-in-out infinite;
  }
  .scroll-chevron:nth-child(2) { animation-delay: 0.2s; border-top-color: rgba(180,180,180,0.2); }
  @keyframes chevronBounce { 0%,100% { transform: translateY(0); opacity: 0.4; } 50% { transform: translateY(4px); opacity: 0.8; } }

  /* ── BUTTONS ── */
  .btn-primary {
    font-family: var(--font-serif);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #f0ece6;
    background: linear-gradient(160deg, #999 0%, #888 100%);
    border: none;
    padding: 1rem 2.5rem;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    display: inline-flex; align-items: center; gap: 0.6rem;
    clip-path: polygon(10px 0%, 100% 0%, calc(100% - 10px) 100%, 0% 100%);
    transform: perspective(700px) translateY(0) translateZ(0);
    transition:
      transform   0.28s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow  0.28s cubic-bezier(0.23, 1, 0.32, 1),
      background  0.28s;
    box-shadow:
      0 5px 0 #111,
      0 8px 28px rgba(180,180,180,0.38),
      inset 0 1px 0 rgba(255,255,255,0.1);
    animation: btnPulse 3s ease-in-out infinite;
  }
  @keyframes btnPulse {
    0%,100% { box-shadow: 0 5px 0 #111, 0 8px 28px rgba(180,180,180,0.38), inset 0 1px 0 rgba(255,255,255,0.1); }
    50%     { box-shadow: 0 5px 0 #333, 0 8px 32px rgba(180,180,180,0.55), 0 0 60px rgba(180,180,180,0.15), inset 0 1px 0 rgba(255,255,255,0.1); }
  }
  .btn-primary::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 45%;
    background: linear-gradient(to bottom, rgba(255,255,255,0.13), transparent);
    pointer-events: none;
  }
  .btn-primary::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(105deg, transparent 30%, rgba(255,255,255,0.2) 50%, transparent 70%);
    transform: translateX(-150%);
    transition: transform 0.55s ease;
    pointer-events: none;
  }
  .btn-primary:hover {
    background: linear-gradient(160deg, #888 0%, #999 100%);
    transform: perspective(700px) translateY(-8px) rotateX(12deg) translateZ(8px);
    box-shadow:
       0 13px 0 #111,
      0 20px 55px rgba(180,180,180,0.68),
      0 0  100px rgba(180,180,180,0.28),
      inset 0 1px 0 rgba(255,255,255,0.18);
  }
  .btn-primary:hover::after { transform: translateX(150%); }
  .btn-primary:active {
    transform: perspective(700px) translateY(-2px) rotateX(5deg) translateZ(2px);
    box-shadow:
       0 3px 0 #111,
      0 5px 18px rgba(180,180,180,0.45),
      inset 0 1px 0 rgba(255,255,255,0.08);
    transition-duration: 0.08s;
  }

  .btn-ghost {
    font-family: var(--font-serif);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ccc;
    background: transparent;
    border: 1px solid rgba(180,180,180,0.5);
    padding: 1rem 2.5rem;
    position: relative;
    overflow: hidden;
    text-decoration: none;
    display: inline-flex; align-items: center; gap: 0.6rem;
    clip-path: polygon(10px 0%, 100% 0%, calc(100% - 10px) 100%, 0% 100%);
    transform: perspective(700px) translateY(0) translateZ(0);
    transition:
      transform    0.28s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow   0.28s cubic-bezier(0.23, 1, 0.32, 1),
      color        0.28s,
      border-color 0.28s;
    box-shadow:
      0 5px 0 rgba(30,30,30,0.35),
      0 6px 20px rgba(180,180,180,0.12);
  }
  .btn-ghost::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(135deg, #999, #888);
    transform: scaleX(0) scaleY(0.85);
    transform-origin: left center;
    transition: transform 0.38s cubic-bezier(0.23, 1, 0.32, 1);
    z-index: -1;
  }
  .btn-ghost::after {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 45%;
    background: linear-gradient(to bottom, rgba(255,255,255,0.07), transparent);
    opacity: 0;
    transition: opacity 0.28s;
    pointer-events: none;
  }
  .btn-ghost:hover {
    color: #f0ece6;
    border-color: #ccc;
    transform: perspective(700px) translateY(-8px) rotateX(12deg) translateZ(8px);
    box-shadow:
       0 13px 0 rgba(30,30,30,0.55),
       0 20px 55px rgba(180,180,180,0.52),
       0 0   70px rgba(180,180,180,0.22);
  }
  .btn-ghost:hover::before { transform: scaleX(1) scaleY(1); }
  .btn-ghost:hover::after  { opacity: 1; }
  .btn-ghost:active {
    transform: perspective(700px) translateY(-2px) rotateX(5deg) translateZ(2px);
    box-shadow:
      0 3px 0 rgba(80,80,80,0.5),
      0 5px 15px rgba(180,180,180,0.3);
    transition-duration: 0.08s;
  }

  /* ── SECTION BASE ── */
  section {
    position: relative; padding: 8rem 2rem;
    contain: layout style paint;
    content-visibility: auto;
    contain-intrinsic-size: 400px;
  }
  section::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(180,180,180,0.08), transparent);
    pointer-events: none;
  }
  .section-inner { max-width: 1200px; margin: 0 auto; }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.45em;
    color: #999;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
    display: flex; align-items: center; gap: 1rem;
  }
  .section-label::after {
    content: '';
    flex: 1; max-width: 80px; height: 1px;
    background: linear-gradient(90deg, var(--accent), transparent);
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 700;
    color: #f2ede8;
    line-height: 1.1;
    text-shadow: 0 0 60px rgba(180,180,180,0.2), 0 2px 0 rgba(0,0,0,0.9);
    margin-bottom: 1.5rem;
  }
  .section-sep {
    width: 60px; height: 2px;
    background: linear-gradient(90deg, var(--accent), #888);
    margin-bottom: 3rem;
    box-shadow: 0 0 10px rgba(180,180,180,0.4);
    position: relative;
  }
  .section-sep::after {
    content: '';
    position: absolute; left: 0; top: -2px;
    width: 8px; height: 6px;
    background: var(--accent);
    border-radius: 50%;
    animation: sepGlide 3s ease-in-out infinite;
    filter: blur(2px);
  }
  @keyframes sepGlide {
    0%,100% { left: 0; opacity: 0.3; }
    50% { left: calc(100% - 8px); opacity: 1; }
  }
  .section-title-gradient {
    background: linear-gradient(135deg, #c8bdb5 0%, var(--accent) 50%, #c8bdb5 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── ABOUT ── */
  #about {
    background: transparent;
    position: relative;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 5rem;
    align-items: center;
  }
  .about-portrait {
    position: relative;
  }
  .about-portrait-frame {
    width: 100%;
    aspect-ratio: 3/4;
    max-width: 360px;
    background: var(--ink-light);
    position: relative;
    overflow: hidden;
    clip-path: polygon(12px 0%, 100% 0%, calc(100% - 12px) 100%, 0% 100%);
    box-shadow: 0 0 40px rgba(180,180,180,0.1), inset 0 0 60px rgba(0,0,0,0.5);
    transition: box-shadow 0.5s, transform 0.5s;
  }
  .about-portrait-frame:hover {
    box-shadow: 0 0 60px rgba(180,180,180,0.2), 0 0 100px rgba(180,180,180,0.08);
    transform: scale(1.01);
  }
  .about-portrait-frame::before {
    content: '';
    position: absolute; inset: 0;
    background: repeating-linear-gradient(
      45deg,
      rgba(180,180,180,0.04) 0px, rgba(180,180,180,0.04) 1px,
      transparent 1px, transparent 14px
    );
    z-index: 1;
    pointer-events: none;
  }
  .about-portrait-frame::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(4,3,5,0.6) 100%);
    z-index: 1;
    pointer-events: none;
  }
  .about-portrait-border {
    position: absolute; inset: -2px;
    clip-path: polygon(12px 0%, 100% 0%, calc(100% - 12px) 100%, 0% 100%);
    border: 1px solid rgba(180,180,180,0.25);
    pointer-events: none;
    z-index: 2;
  }
  .about-portrait-border2 {
    position: absolute; top: 14px; left: 14px; right: -14px; bottom: -14px;
    clip-path: polygon(12px 0%, 100% 0%, calc(100% - 12px) 100%, 0% 100%);
    border: 1px solid rgba(180,180,180,0.08);
    pointer-events: none;
    z-index: 0;
  }
  .about-portrait-corner {
    position: absolute; z-index: 3; pointer-events: none;
    font-family: var(--font-mono); font-size: 0.5rem;
    color: var(--accent); letter-spacing: 0.1em;
  }
  .about-portrait-corner.tl { top: 6px; left: 10px; }
  .about-portrait-corner.br { bottom: 6px; right: 10px; }
  .about-text p {
    font-size: 1.05rem;
    line-height: 2.1;
    color: #c0bbb5;
    margin-bottom: 1.5rem;
    position: relative;
    padding-left: 0.8rem;
    border-left: 1px solid rgba(180,180,180,0.08);
  }
  .about-text p:first-of-type { border-left-color: rgba(180,180,180,0.15); }
  .about-text p:first-of-type::first-letter {
    font-family: var(--font-display);
    font-size: 3.2rem;
    float: left;
    line-height: 0.85;
    margin-right: 0.5rem;
    color: var(--accent);
    text-shadow: 0 0 20px rgba(180,180,180,0.3);
  }
  .about-text p strong { color: #f0ece6; font-style: normal; font-weight: 700; }
  .about-stats {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem; margin-top: 3rem;
  }
  .stat-card {
    background: rgba(180,180,180,0.03);
    padding: 1.8rem 1rem;
    text-align: center;
    position: relative;
    overflow: hidden;
    clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
    border: 1px solid rgba(180,180,180,0.12);
    transition: all 0.4s;
  }
  .stat-card::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(180,180,180,0.08), transparent);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .stat-card::after {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    transform: scaleX(0);
    transition: transform 0.4s;
  }
  .stat-icon { transition: all 0.4s; display: inline-block; }
  .stat-card:hover .stat-icon { color: var(--accent); text-shadow: 0 0 20px rgba(180,180,180,0.5); transform: scale(1.15); }
  .stat-card:hover {
    border-color: rgba(180,180,180,0.4);
    background: rgba(180,180,180,0.08);
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(180,180,180,0.18);
  }
  .stat-card:hover::before { opacity: 1; }
  .stat-card:hover::after { transform: scaleX(1); }
  .stat-number {
    font-family: var(--font-display);
    font-size: 2.4rem;
    color: #999;
    text-shadow: 0 0 30px rgba(180,180,180,0.5);
    display: block;
    line-height: 1.2;
  }
  .stat-icon {
    display: block;
    font-size: 1.2rem;
    margin-bottom: 0.3rem;
    opacity: 0.3;
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    letter-spacing: 0.25em;
    color: #8a8480;
    text-transform: uppercase;
    margin-top: 0.3rem;
    display: block;
  }

  /* ── SKILLS ── */
  #skills { background: transparent; }
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.8rem;
  }
  .skill-category {
    border: 1px solid rgba(180,180,180,0.15);
    padding: 2rem 1.8rem;
    background: rgba(180,180,180,0.02);
    position: relative;
    overflow: hidden;
    transition: all 0.4s;
    clip-path: polygon(10px 0%, 100% 0%, calc(100% - 10px) 100%, 0% 100%);
  }
  .skill-category::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    transform: scaleX(0);
    transition: transform 0.5s ease;
  }
  .skill-category::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(180,180,180,0.04), transparent 50%);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .skill-category:hover {
    border-color: rgba(180,180,180,0.4);
    transform: translateY(-5px);
    box-shadow: 0 12px 40px rgba(180,180,180,0.15), 0 0 60px rgba(180,180,180,0.05);
  }
  .skill-category:hover::before { transform: scaleX(1); }
  .skill-category:hover::after { opacity: 1; }
  .skill-item { transition: color 0.3s; }
  .skill-category:hover .skill-item { color: #e0dbd5; }
  .skill-cat-title {
    font-family: var(--font-serif);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #999;
    margin-bottom: 1.5rem;
    display: flex; align-items: center; gap: 0.8rem;
    position: relative;
    z-index: 1;
  }
  .skill-cat-icon {
    font-size: 1.1rem;
    opacity: 0.6;
  }
  .skill-list { list-style: none; display: flex; flex-direction: column; gap: 0.8rem; position: relative; z-index: 1; }
  .skill-item {
    display: flex; align-items: center; justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: #c8c2bc;
    position: relative;
    padding: 0.2rem 0;
  }
  .skill-item::after {
    content: '';
    position: absolute; bottom: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, rgba(180,180,180,0.1), transparent);
  }
  .skill-bar-track {
    width: 100px; height: 4px;
    background: rgba(255,255,255,0.08);
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    contain: strict;
  }
  .skill-bar-fill {
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: linear-gradient(90deg, #aaa, #ddd);
    transform: scaleX(var(--fill, 0));
    transform-origin: left;
    transition: transform 1.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 10px rgba(180,180,180,0.6);
    border-radius: 2px;
    will-change: transform;
  }
  .skill-bar-fill::after {
    content: '';
    position: absolute; top: 0; left: 0; right: 50%;
    height: 100%;
    background: linear-gradient(90deg, rgba(255,255,255,0.15), transparent);
    border-radius: 2px;
  }
  .skill-pct {
    font-size: 0.6rem;
    color: rgba(180,180,180,0.5);
    min-width: 2rem;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /* ── SECTION BLOOD SPLASH ── */
  .section-blood {
    position: absolute; top: -20px; right: 10%;
    font-family: var(--font-display);
    font-size: 10rem;
    color: rgba(180,180,180,0.03);
    pointer-events: none;
    user-select: none;
    line-height: 1;
    z-index: 0;
    animation: bloodFloat 6s ease-in-out infinite;
  }
  .section-blood.alt { animation-delay: -3s; right: 15%; top: -10px; font-size: 8rem; }
  @keyframes bloodFloat {
    0%,100% { transform: translateY(0) rotate(0deg); }
    33%     { transform: translateY(-12px) rotate(1deg); }
    66%     { transform: translateY(8px) rotate(-1deg); }
  }

  /* ── PROJECTS ── */
  #projects { background: transparent; }
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
    gap: 2rem;
  }
  .project-card.featured {
    border-color: rgba(180,180,180,0.35);
    position: relative;
  }
  .project-card {
    border: 1px solid rgba(180,180,180,0.2);
    background: rgba(10,8,12,0.85);
    position: relative;
    overflow: hidden;
    transition: border-color 0.5s, box-shadow 0.5s, transform 0.5s cubic-bezier(0.23,1,0.32,1);
    transform-style: preserve-3d;
    transform:
      perspective(900px)
      rotateX(var(--rx, 0deg))
      rotateY(var(--ry, 0deg))
      translateY(var(--hover-y, 0px))
      translateZ(var(--rz, 0px));
    will-change: transform;
  }
  .project-card::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(180,180,180,0.06), transparent 60%);
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
  }
  .project-card:hover {
    border-color: rgba(180,180,180,0.55);
    box-shadow: 0 20px 60px rgba(180,180,180,0.3), 0 0 80px rgba(180,180,180,0.08);
    --hover-y: -6px;
  }
  .project-card:hover::after { opacity: 1; }
  .project-card.featured:hover {
    border-color: rgba(180,180,180,0.75);
    box-shadow: 0 0 45px rgba(180,180,180,0.35), 0 0 90px rgba(180,180,180,0.12), 0 20px 60px rgba(180,180,180,0.2);
    --hover-y: -6px;
  }
  .project-thumb {
    height: 200px;
    background: var(--ink-light);
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid rgba(180,180,180,0.1);
    isolation: isolate;
  }
  .project-thumb::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(180deg, transparent 30%, rgba(4,3,5,0.7) 100%);
    pointer-events: none;
    z-index: 1;
  }
  .project-thumb-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(180,180,180,0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(180,180,180,0.06) 1px, transparent 1px);
    background-size: 30px 30px;
    animation: gridScroll 8s linear infinite;
    transition: opacity 0.4s;
  }
  .project-card:hover .project-thumb-grid {
    animation-duration: 3s;
    opacity: 0.6;
  }
  @keyframes gridScroll { to { background-position: 30px 30px; } }
  .project-thumb-label {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem;
    font-family: var(--font-mono); font-size: 0.65rem;
    letter-spacing: 0.15em; color: var(--accent);
    text-align: center; padding: 1.5rem;
    z-index: 2;
  }
  .project-thumb-label .project-icon {
    font-size: 2.8rem; opacity: 0.35;
    display: block; margin-bottom: 0.5rem;
    transition: all 0.5s;
    filter: drop-shadow(0 0 10px rgba(180,180,180,0.2));
  }
  .project-card:hover .project-icon {
    opacity: 0.8;
    transform: scale(1.2) rotate(5deg);
    filter: drop-shadow(0 0 20px rgba(180,180,180,0.4));
  }
  .project-thumb-img {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    z-index: 3;
    pointer-events: none;
  }
  .project-thumb-img svg {
    width: 56px; height: 56px;
    opacity: 0.25;
    transition: opacity 0.5s, transform 0.5s cubic-bezier(0.23,1,0.32,1);
  }
  .project-card:hover .project-thumb-img svg {
    opacity: 0.6;
    transform: scale(1.15);
  }
  .project-thumb-dots {
    position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%);
    display: flex; gap: 4px; z-index: 2;
  }
  .project-thumb-dots span {
    width: 4px; height: 4px; border-radius: 50%;
    background: rgba(180,180,180,0.3);
    transition: all 0.3s;
  }
  .project-card:hover .project-thumb-dots span { background: rgba(180,180,180,0.7); }
  .project-thumb-dots span:nth-child(2) { width: 12px; border-radius: 2px; }
  .project-body {
    padding: 1.8rem 2rem 2rem;
    position: relative;
    z-index: 1;
  }
  .project-badge {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: var(--font-mono); font-size: 0.5rem;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: #8a8480;
    padding: 0.25rem 0.6rem;
    border: 1px solid rgba(180,180,180,0.2);
    background: rgba(180,180,180,0.06);
    margin-bottom: 0.7rem;
    clip-path: polygon(3px 0%, 100% 0%, calc(100% - 3px) 100%, 0% 100%);
  }
  .project-badge-dot {
    width: 5px; height: 5px; border-radius: 50%;
    display: inline-block;
    animation: badgePulse 1.8s ease-in-out infinite;
  }
  .project-badge-dot.live {
    background: #4caf50 !important;
    animation-name: badgePulseLive;
  }
  @keyframes badgePulse {
    0%,100% { opacity: 0.4; box-shadow: 0 0 0 rgba(180,180,180,0); }
    50% { opacity: 1; box-shadow: 0 0 6px rgba(180,180,180,0.8); }
  }
  @keyframes badgePulseLive {
    0%,100% { opacity: 0.5; box-shadow: 0 0 0 rgba(76,175,80,0); }
    50% { opacity: 1; box-shadow: 0 0 8px rgba(76,175,80,0.7); }
  }
  .project-tag-row { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.8rem; }
  .project-tag {
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #7a4a4a;
    border: 1px solid rgba(180,180,180,0.2);
    padding: 0.2rem 0.5rem;
    background: rgba(180,180,180,0.04);
    transition: all 0.3s;
    clip-path: polygon(3px 0%, 100% 0%, calc(100% - 3px) 100%, 0% 100%);
  }
  .project-tag:hover {
    background: rgba(180,180,180,0.12);
    border-color: rgba(180,180,180,0.5);
    color: #c0a0a0;
  }
  .project-tag-csharp {
    color: #9B4F96; border-color: rgba(155,79,150,0.25);
    background: rgba(155,79,150,0.06);
  }
  .project-tag-csharp:hover {
    background: rgba(155,79,150,0.15);
    border-color: rgba(155,79,150,0.5);
    color: #c080c0;
  }
  .project-tag-win {
    color: #3578E5; border-color: rgba(53,120,229,0.25);
    background: rgba(53,120,229,0.06);
  }
  .project-tag-win:hover {
    background: rgba(53,120,229,0.15);
    border-color: rgba(53,120,229,0.5);
  }
  .project-tag-dotnet {
    color: #512BD4; border-color: rgba(81,43,212,0.25);
    background: rgba(81,43,212,0.06);
  }
  .project-tag-dotnet:hover {
    background: rgba(81,43,212,0.15);
    border-color: rgba(81,43,212,0.5);
  }
  .project-name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: #f0ece6;
    margin-bottom: 0.6rem;
    letter-spacing: 0.02em;
    transition: all 0.3s;
  }
  .project-card:hover .project-name {
    color: #fff;
    text-shadow: 0 0 25px rgba(180,180,180,0.25);
  }
  .project-desc {
    font-size: 0.85rem;
    line-height: 1.8;
    color: #b0aca6;
    margin-bottom: 1.3rem;
    transition: color 0.3s;
  }
  .project-card:hover .project-desc {
    color: #c8c4be;
  }
  .project-links { display: flex; gap: 1.2rem; flex-wrap: wrap; }
  .project-link {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    color: #999;
    text-decoration: none;
    text-transform: uppercase;
    display: inline-flex; align-items: center; gap: 0.4rem;
    transition: all 0.3s;
    border-bottom: 1px solid rgba(180,180,180,0.3);
    padding-bottom: 2px;
    position: relative;
  }
  .project-link:hover { color: #ccc; border-color: #ccc; gap: 0.7rem; }

  /* ── SERVICES ── */
  #services { background: transparent; }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .service-card {
    padding: 2.5rem 2rem;
    border: 1px solid rgba(180,180,180,0.12);
    background: rgba(180,180,180,0.02);
    position: relative;
    overflow: hidden;
    transition: all 0.4s;
    clip-path: polygon(10px 0%, 100% 0%, calc(100% - 10px) 100%, 0% 100%);
  }
  .service-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(180,180,180,0.06);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.4s ease;
    will-change: transform;
  }
  .service-card::after {
    content: '';
    position: absolute; top: 0; left: 0; bottom: 0; width: 2px;
    background: linear-gradient(to bottom, transparent, var(--accent), transparent);
    transform: scaleY(0);
    transition: transform 0.4s ease;
    transform-origin: top;
  }
  .service-card-corner {
    position: absolute; width: 20px; height: 20px;
    border: 0 solid var(--accent);
    transition: all 0.4s ease;
    opacity: 0;
    pointer-events: none;
  }
  .service-card-corner.tl { top: 4px; left: 4px; border-top-width: 1px; border-left-width: 1px; }
  .service-card-corner.br { bottom: 4px; right: 4px; border-bottom-width: 1px; border-right-width: 1px; }
  .service-card:hover .service-card-corner { opacity: 0.4; width: 16px; height: 16px; }
  .service-card:hover {
    border-color: rgba(180,180,180,0.4);
    transform: translateY(-5px);
    box-shadow: 0 12px 35px rgba(180,180,180,0.12), 0 0 50px rgba(180,180,180,0.04);
  }
  .service-card:hover::before { transform: scaleY(1); }
  .service-card:hover::after { transform: scaleY(1); }
  .service-card:hover .service-name { color: #fff; text-shadow: 0 0 20px rgba(180,180,180,0.3); }
  .service-name { transition: color 0.3s, text-shadow 0.3s; }
  .service-num {
    font-family: var(--font-display);
    font-size: 3rem;
    color: rgba(180,180,180,0.15);
    line-height: 1;
    margin-bottom: 1.2rem;
    transition: all 0.4s;
    display: inline-block;
    position: relative;
  }
  .service-num::after {
    content: '';
    position: absolute; bottom: -2px; left: 0; right: 0;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.4s;
    transform-origin: left;
  }
  .service-card:hover .service-num {
    color: rgba(180,180,180,0.5);
    text-shadow: 0 0 30px rgba(180,180,180,0.3);
  }
  .service-card:hover .service-num::after { transform: scaleX(1); }
  .service-name {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 700;
    color: #f0ece6;
    letter-spacing: 0.06em;
    margin-bottom: 0.8rem;
    position: relative;
    z-index: 1;
  }
  .service-desc {
    font-size: 0.85rem;
    line-height: 1.9;
    color: #b0aba5;
    position: relative;
    z-index: 1;
  }

  /* ── CONTACT ── */
  #contact {
    background: transparent;
    text-align: center;
    position: relative;
  }
  .contact-inner {
    max-width: 700px; margin: 0 auto;
    background: rgba(180,180,180,0.02);
    border: 1px solid rgba(180,180,180,0.08);
    padding: 4rem 3rem;
    clip-path: polygon(16px 0%, 100% 0%, calc(100% - 16px) 100%, 0% 100%);
    position: relative;
  }
  .contact-inner::before {
    content: '';
    position: absolute; inset: -1px;
    clip-path: polygon(16px 0%, 100% 0%, calc(100% - 16px) 100%, 0% 100%);
    border: 1px solid rgba(180,180,180,0.12);
    pointer-events: none;
  }
  .contact-inner::after {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0.3;
  }
  .contact-subtitle {
    font-size: 1rem;
    line-height: 2;
    color: #c0bbb5;
    font-style: italic;
    margin-bottom: 2.5rem;
  }
  .contact-links {
    display: flex; gap: 2.5rem;
    justify-content: center; flex-wrap: wrap;
    margin-top: 3rem;
  }
  .contact-link {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: #8a8480;
    text-decoration: none;
    text-transform: uppercase;
    display: inline-flex; align-items: center; gap: 0.5rem;
    transition: all 0.3s;
    position: relative;
    padding: 0.5rem 1rem;
    border: 1px solid transparent;
  }
  .contact-link::before {
    content: '';
    position: absolute; inset: 0;
    border: 1px solid rgba(180,180,180,0.15);
    clip-path: polygon(4px 0%, 100% 0%, calc(100% - 4px) 100%, 0% 100%);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .contact-link::after {
    content: '';
    position: absolute; bottom: -4px; left: 20%; right: 20%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.3s;
  }
  .contact-link:hover {
    color: #c8c4be;
  }
  .contact-link:hover::before { opacity: 1; }
  .contact-link:hover::after { transform: scaleX(1); }
  .contact-separator {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: rgba(180,180,180,0.2);
    letter-spacing: 0.2em;
  }
  .contact-dc-btn {
    margin-top: 2rem;
  }

  /* ── FOOTER ── */
  footer {
    padding: 2.5rem 4rem;
    border-top: 1px solid rgba(180,180,180,0.1);
    display: flex; align-items: center; justify-content: space-between;
    background: transparent;
    position: relative;
  }
  footer::before {
    content: '';
    position: absolute; top: -1px; left: 10%; right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
  }
  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    color: #6a6460;
    text-transform: uppercase;
    transition: color 0.3s, text-shadow 0.3s;
  }
  .footer-copy:hover { color: #8a8480; text-shadow: 0 0 15px rgba(180,180,180,0.3); }
  .footer-blood {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    color: #888;
    display: flex; align-items: center; gap: 0.5rem;
    transition: color 0.3s, text-shadow 0.3s;
  }
  .footer-blood:hover { color: #999; text-shadow: 0 0 20px rgba(180,180,180,0.4); }
  .footer-blood::before {
    content: '◈';
    color: var(--accent);
    font-size: 0.5rem;
    opacity: 0.5;
    transition: opacity 0.3s, transform 0.3s;
  }
  .footer-blood:hover::before { opacity: 1; transform: rotate(180deg); }

  /* ── GLITCH ANIMATION ── */
  .glitch { position: relative; }
  .glitch::before, .glitch::after {
    content: attr(data-text);
    position: absolute; left: 0; top: 0;
    width: 100%; height: 100%;
    font-family: inherit; font-size: inherit; font-weight: inherit;
  }
  .glitch::before {
    color: #ccc;
    animation: glitch1 2.8s infinite steps(1);
    clip-path: polygon(0 20%, 100% 20%, 100% 45%, 0 45%);
    text-shadow: 0 0 10px rgba(180,180,180,0.5);
  }
  .glitch::after {
    color: #1a0a0a;
    animation: glitch2 2.8s infinite steps(1);
    clip-path: polygon(0 55%, 100% 55%, 100% 80%, 0 80%);
    opacity: 0.7;
    text-shadow: 0 0 10px rgba(0,0,0,0.5);
  }
  @keyframes glitch1 {
    0%,85%,100% { transform: none; opacity: 0; }
    86% { transform: translate(-5px,2px) skewX(-3deg); opacity: 0.9; }
    88% { transform: translate(5px,-2px) skewX(3deg); opacity: 0.9; }
    90% { transform: translate(-3px,3px); opacity: 0.6; }
    92% { transform: translate(4px,-1px) skewX(-2deg); opacity: 0.9; }
    94% { transform: translate(-2px,1px); opacity: 0.4; }
    96% { transform: none; opacity: 0; }
  }
  @keyframes glitch2 {
    0%,82%,100% { transform: none; opacity: 0; }
    83% { transform: translate(5px,2px) skewX(2deg); opacity: 0.7; }
    85% { transform: translate(-4px,-1px); opacity: 0.7; }
    87% { transform: translate(3px,2px) skewX(-1deg); opacity: 0.7; }
    89% { transform: translate(-5px,-2px); opacity: 0.5; }
    91% { transform: translate(2px,0px); opacity: 0.3; }
    93% { transform: none; opacity: 0; }
  }

  /* ── DRIP EFFECT ── */
  .drip-container {
    position: absolute; top: 0; left: 0; right: 0;
    height: 60px; overflow: visible; pointer-events: none;
    z-index: 10;
  }
  .drip {
    position: absolute; top: 0;
    width: 3px;
    background: linear-gradient(to bottom, var(--accent), transparent);
    border-radius: 0 0 4px 4px;
    animation: drip var(--dur, 3s) var(--delay, 0s) ease-in infinite;
  }
  @keyframes drip {
    0% { height: 0; opacity: 0.8; transform: translateY(0); }
    40% { height: var(--h, 40px); opacity: 0.8; }
    80% { height: var(--h, 40px); opacity: 0.3; }
    100% { height: var(--h, 40px); opacity: 0; transform: translateY(4px); }
  }

  /* ── FLOATING RUNES ── */
  .rune {
    position: absolute;
    font-family: var(--font-display);
    color: rgba(180,180,180,0.06);
    pointer-events: none;
    user-select: none;
    animation: runeFloat var(--dur, 8s) var(--delay, 0s) ease-in-out infinite alternate;
  }
  @keyframes runeFloat {
    from { transform: translateY(0) rotate(var(--rot0, 0deg)); opacity: 0.04; }
    to { transform: translateY(-20px) rotate(var(--rot1, 5deg)); opacity: 0.08; }
  }

  /* ── SCROLL REVEAL — 3D INDIVIDUAL ── */
  .reveal { opacity: 0; }
  .reveal.in-view {
    /* --ra : keyframe name  --rd : duration  --delay : animation-delay */
    animation: var(--ra, rv-rise) var(--rd, 1s) var(--delay, 0s) cubic-bezier(0.16,1,0.3,1) both;
  }

  /* Per-component animation style — set via CSS variable, no JSX changes needed */
  .section-label    { --ra: rv-left;    --rd: 0.9s;  }
  .section-title    { --ra: rv-flip;    --rd: 1.1s;  }
  .section-sep      { --ra: rv-expand;  --rd: 0.8s;  }
  .about-portrait   { --ra: rv-left;    --rd: 1.1s;  }
  .about-text .reveal { --ra: rv-rise;  --rd: 1s;    }
  .skill-category   { --ra: rv-spin-in; --rd: 1s;    }
  .project-card     { --ra: rv-pop;     --rd: 1s;    }
  .service-card     { --ra: rv-pop;     --rd: 0.9s;  }
  .about-stats      { --ra: rv-pop;     --rd: 1.05s; }
  .contact-subtitle { --ra: rv-rise;    --rd: 1s;    }
  .contact-links    { --ra: rv-pop;     --rd: 0.9s;  }
  /* Services num get dramatic flip */
  .service-num      { transition: color 0.4s, transform 0.4s cubic-bezier(0.23,1,0.32,1); }
  .service-card:hover .service-num { transform: perspective(400px) rotateX(10deg) scale(1.1); }

  /* Stagger delays — replaces transition-delay with animation-delay variable */
  .reveal-delay-1 { --delay: 0.10s; }
  .reveal-delay-2 { --delay: 0.22s; }
  .reveal-delay-3 { --delay: 0.34s; }
  .reveal-delay-4 { --delay: 0.46s; }

  /* ── DISCORD MODAL ── */
  .dc-backdrop {
    position: fixed; inset: 0; z-index: 500;
    background: rgba(0,0,0,0.78);
    backdrop-filter: blur(6px);
    display: flex; align-items: center; justify-content: center;
    animation: fadeIn 0.22s ease both;
  }
  .dc-modal {
    background: #0e0b14;
    border: 1px solid rgba(180,180,180,0.45);
    box-shadow: 0 0 80px rgba(80,80,80,0.55), 0 0 160px rgba(80,80,80,0.25), inset 0 1px 0 rgba(255,255,255,0.06);
    padding: 2.8rem 2.6rem 2.2rem;
    max-width: 420px; width: calc(100% - 3rem);
    text-align: center;
    position: relative;
    animation: rv-pop 0.55s cubic-bezier(0.16,1,0.3,1) both;
    clip-path: polygon(14px 0%, 100% 0%, calc(100% - 14px) 100%, 0% 100%);
  }
  .dc-modal::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, #ccc 40%, #5865F2 60%, transparent);
  }
  .dc-icon {
    width: 64px; height: 64px;
    margin: 0 auto 1.5rem;
    background: #5865F2;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 40px rgba(88,101,242,0.55), 0 0 80px rgba(88,101,242,0.2);
    animation: rv-drop 0.7s 0.1s cubic-bezier(0.16,1,0.3,1) both;
  }
  .dc-icon svg { width: 36px; height: 36px; fill: #fff; }
  .dc-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: #f0ece6;
    margin-bottom: 0.8rem;
    text-shadow: 0 0 40px rgba(88,101,242,0.3);
  }
  .dc-body {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.8;
    color: #b0abb8;
    font-style: italic;
    margin-bottom: 2rem;
  }
  .dc-actions {
    display: flex; gap: 1rem; justify-content: center;
    flex-wrap: wrap;
  }
  .dc-btn-accept {
    font-family: var(--font-serif);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #fff;
    background: linear-gradient(135deg, #5865F2, #3a44c4);
    border: none;
    padding: 0.85rem 2rem;
    text-decoration: none;
    display: inline-flex; align-items: center; gap: 0.5rem;
    clip-path: polygon(6px 0%, 100% 0%, calc(100% - 6px) 100%, 0% 100%);
    transform: perspective(600px) translateY(0);
    transition: transform 0.25s cubic-bezier(0.23,1,0.32,1), box-shadow 0.25s;
    box-shadow: 0 5px 0 #1c236e, 0 8px 24px rgba(88,101,242,0.42);
  }
  .dc-btn-accept:hover {
    transform: perspective(600px) translateY(-5px) rotateX(10deg) translateZ(4px);
    box-shadow: 0 11px 0 #1c236e, 0 18px 45px rgba(88,101,242,0.65);
  }
  .dc-btn-accept:active {
    transform: perspective(600px) translateY(-1px) rotateX(3deg);
    box-shadow: 0 2px 0 #1c236e, 0 4px 12px rgba(88,101,242,0.4);
    transition-duration: 0.07s;
  }
  .dc-btn-reject {
    font-family: var(--font-serif);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #9a9490;
    background: transparent;
    border: 1px solid rgba(180,180,180,0.35);
    padding: 0.85rem 2rem;
    text-decoration: none;
    display: inline-block;
    clip-path: polygon(6px 0%, 100% 0%, calc(100% - 6px) 100%, 0% 100%);
    transform: perspective(600px) translateY(0);
    transition: transform 0.25s cubic-bezier(0.23,1,0.32,1), box-shadow 0.25s, color 0.25s, border-color 0.25s;
    box-shadow: 0 5px 0 rgba(80,80,80,0.3);
  }
  .dc-btn-reject:hover {
    color: #f0ece6;
    border-color: rgba(180,180,180,0.65);
    transform: perspective(600px) translateY(-5px) rotateX(10deg) translateZ(4px);
    box-shadow: 0 11px 0 rgba(80,80,80,0.45), 0 16px 35px rgba(180,180,180,0.35);
  }
  .dc-btn-reject:active {
    transform: perspective(600px) translateY(-1px) rotateX(3deg);
    box-shadow: 0 2px 0 rgba(80,80,80,0.4);
    transition-duration: 0.07s;
  }

  /* ── HERO AURA PULSE ── */
  .hero-aura {
    position: absolute; top: 50%; left: 50%;
    width: 400px; height: 400px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(180,180,180,0.08) 0%, transparent 70%);
    animation: auraPulse 4s ease-in-out infinite;
    pointer-events: none; z-index: 0;
  }
  @keyframes auraPulse {
    0%,100% { transform: translate(-50%,-50%) scale(1); opacity: 0.3; }
    50% { transform: translate(-50%,-50%) scale(1.15); opacity: 0.6; }
  }
  .hero-aura-2 {
    width: 550px; height: 550px;
    background: radial-gradient(circle, rgba(80,80,80,0.05) 0%, transparent 70%);
    animation: auraPulse 6s ease-in-out infinite reverse;
  }
  .hero-aura-3 {
    width: 350px; height: 350px;
    background: radial-gradient(circle, rgba(80,80,80,0.04) 0%, transparent 70%);
    animation: auraPulse 5s ease-in-out infinite;
    opacity: 0.3;
  }

  /* ── COMET / SHOOTING STAR ── */
  .comet-container {
    position: fixed; inset: 0; z-index: 1; pointer-events: none;
    overflow: hidden;
  }
  .comet {
    position: absolute;
    width: 3px; height: 3px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 6px 2px rgba(180,180,180,0.6);
    animation: cometFly var(--cdur, 4s) var(--cdelay, 0s) linear infinite;
    opacity: 0;
  }
  .comet::after {
    content: '';
    position: absolute; top: 50%; right: 100%;
    width: 60px; height: 1px;
    background: linear-gradient(to left, rgba(180,180,180,0.8), transparent);
    transform: translateY(-50%);
  }
  @keyframes cometFly {
    0% { transform: translate(0,0) rotate(-35deg); opacity: 0; }
    5% { opacity: 1; }
    25% { opacity: 1; }
    40% { opacity: 0; }
    100% { transform: translate(calc(-100vw - 100px), calc(100vh + 100px)) rotate(-35deg); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
    .hero-aura, .hero-aura-2, .hero-aura-3 { display: none; }
    .katana-hero * { animation-play-state: paused !important; }
  }
  @media (max-width: 1024px) {
    nav { padding: 1rem 2rem; }
  }
  @media (max-width: 768px) {
    nav { padding: 1rem 1.5rem; }
    .nav-links {
      position: fixed; top: 0; right: 0; width: 70%; max-width: 300px;
      height: 100vh; flex-direction: column; gap: 0;
      background: rgba(4,3,5,0.98); backdrop-filter: blur(20px);
      padding: 5rem 2rem 2rem; transition: transform 0.4s cubic-bezier(0.23,1,0.32,1);
      border-left: 1px solid rgba(180,180,180,0.2); z-index: 99;
      transform: translateX(100%); will-change: transform;
    }
    .nav-open .nav-links { transform: translateX(0); }
    .nav-links li::before { display: none; }
    .nav-links a { font-size: 0.9rem; padding: 0.8rem 0; display: block; border-bottom: 1px solid rgba(180,180,180,0.08); }
    .nav-toggle { display: flex; z-index: 100; }
    .about-grid { grid-template-columns: 1fr; gap: 3rem; }
    .about-portrait-frame { max-width: 250px; }
    .projects-grid { grid-template-columns: 1fr; }
    footer { flex-direction: column; gap: 1rem; text-align: center; }
    .katana-hero { display: none; }
    .hero-aura { width: 300px; height: 300px; }
    .hero-aura-3 { display: none; }
    .section-label { font-size: 0.55rem; }
    .contact-links { gap: 1.5rem; }
    .hero-desc::before, .hero-desc::after { display: none; }
  }
  @media (max-width: 480px) {
    .hero-name { font-size: clamp(2.5rem, 12vw, 4rem); }
    .section-title { font-size: clamp(1.8rem, 7vw, 2.5rem); }
    .project-body { padding: 1.5rem; }
    .services-grid { grid-template-columns: 1fr; }
    .about-stats { grid-template-columns: 1fr; }
  }

  /* ── GOTHIC KATANA ── */
  .katana-hero {
    position: absolute; right: 7%; top: 50%;
    transform: translateY(-50%) rotate(-8deg);
    width: 110px; height: 460px;
    z-index: 2;
    opacity: 0;
    animation: rv-right 1.2s 1.5s cubic-bezier(0.16,1,0.3,1) forwards;
    pointer-events: all;
  }
  .katana-hero svg { overflow: visible; filter: drop-shadow(0 0 5px rgba(180,180,180,0.12)); transition: filter 0.45s ease; }
  .katana-hero:hover svg { filter: drop-shadow(0 0 22px rgba(180,180,180,0.75)) drop-shadow(0 0 55px rgba(100,100,100,0.35)); }
  .k-blood-drip { opacity: 0; transform-box: fill-box; transform-origin: top center; }
  .katana-hero:hover .k-blood-drip-1 { animation: kDrip 1.4s 0.1s ease-in both; }
  .katana-hero:hover .k-blood-drip-2 { animation: kDrip 1.6s 0.4s ease-in both; }
  .katana-hero:hover .k-blood-drip-3 { animation: kDrip 1.2s 0.7s ease-in both; }
  @keyframes kDrip {
    0%   { opacity: 0; transform: translateY(0); }
    8%   { opacity: 0.95; }
    82%  { opacity: 0.75; transform: translateY(52px); }
    100% { opacity: 0; transform: translateY(68px); }
  }
  .k-charge { stroke-dasharray: 295; stroke-dashoffset: 295; }
  .katana-hero:hover .k-charge { animation: kCharge 0.65s 0.04s ease-out forwards; }
  @keyframes kCharge { to { stroke-dashoffset: 0; } }
  .k-ring { stroke-dasharray: 174; stroke-dashoffset: 174; opacity: 0; }
  .katana-hero:hover .k-ring { animation: kRing 0.95s 0.06s cubic-bezier(0.16,1,0.3,1) forwards; }
  @keyframes kRing {
    0%   { stroke-dashoffset: 174; opacity: 0; }
    14%  { opacity: 0.92; }
    100% { stroke-dashoffset: 0; opacity: 0.78; }
  }
  .k-ring-outer { opacity: 0; transform-box: fill-box; transform-origin: center; }
  .katana-hero:hover .k-ring-outer { animation: kRingExpand 1.1s 0.3s ease-out forwards; }
  @keyframes kRingExpand {
    0%   { opacity: 0.7; transform: scale(0.55); }
    100% { opacity: 0; transform: scale(2.1); }
  }
  .k-glow-overlay { opacity: 0; }
  .katana-hero:hover .k-glow-overlay { animation: kGlow 1.6s 0.25s ease-in-out infinite alternate; }
  .katana-hero.scrolling * { animation-play-state: paused !important; }
  @keyframes kGlow { from { opacity: 0.12; } to { opacity: 0.44; } }
  @media (max-width: 900px) { .katana-hero { display: none; } }

  /* ── SHOW MORE BUTTON ── */
  .show-more-wrap {
    display: flex; justify-content: center; margin-top: 3.5rem;
  }
  .btn-show-more {
    font-family: var(--font-serif);
    font-size: 0.75rem; letter-spacing: 0.28em; text-transform: uppercase;
    color: #c8c4be; background: transparent;
    border: 1px solid rgba(180,180,180,0.38);
    padding: 1.1rem 3.2rem;
    position: relative; overflow: hidden;
    display: inline-flex; align-items: center; gap: 0.9rem;
    clip-path: polygon(10px 0%, 100% 0%, calc(100% - 10px) 100%, 0% 100%);
    transform: perspective(700px) translateY(0);
    transition: color 0.3s, border-color 0.3s,
                transform 0.3s cubic-bezier(0.23,1,0.32,1),
                box-shadow 0.3s;
    box-shadow: 0 4px 0 rgba(80,80,80,0.2);
  }
  .btn-show-more .sm-icon {
    font-size: 1rem; opacity: 0.55; transition: transform 0.3s, opacity 0.3s;
  }
  .btn-show-more .sm-arrow {
    font-size: 0.85rem; opacity: 0.4; transition: transform 0.3s, opacity 0.3s;
  }
  .btn-show-more::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(135deg, #ccc 0%, #888 100%);
    transform: scaleX(0); transform-origin: left center;
    transition: transform 0.42s cubic-bezier(0.23,1,0.32,1);
    z-index: -1;
  }
  .btn-show-more::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(105deg, transparent 25%, rgba(255,255,255,0.18) 50%, transparent 75%);
    transform: translateX(-160%);
    transition: transform 0.65s ease;
    pointer-events: none;
  }
  .btn-show-more:hover {
    color: #f0ece6; border-color: rgba(180,180,180,0.8);
    transform: perspective(700px) translateY(-6px) rotateX(10deg) translateZ(5px);
    box-shadow: 0 12px 0 rgba(60,60,60,0.45), 0 18px 50px rgba(180,180,180,0.4), 0 0 80px rgba(180,180,180,0.15);
  }
  .btn-show-more:hover::before { transform: scaleX(1); }
  .btn-show-more:hover::after  { transform: translateX(160%); }
  .btn-show-more:hover .sm-icon  { transform: rotate(90deg); opacity: 0.9; }
  .btn-show-more:hover .sm-arrow { transform: translateX(4px) translateY(-4px); opacity: 0.85; }
  .btn-show-more:active {
    transform: perspective(700px) translateY(-2px) rotateX(4deg);
    box-shadow: 0 3px 0 rgba(80,80,80,0.4);
    transition-duration: 0.08s;
  }
  .btn-show-more.exiting {
    animation: smExit 0.52s cubic-bezier(0.55,0,1,0.45) forwards;
  }
  @keyframes smExit {
    0%   { transform: perspective(700px) scale(1)    translateY(-6px); opacity: 1; box-shadow: 0 12px 0 rgba(60,60,60,0.45), 0 18px 50px rgba(180,180,180,0.4); }
    35%  { transform: perspective(700px) scale(1.14) translateY(-10px); opacity: 0.9; box-shadow: 0 0 80px rgba(180,180,180,0.9), 0 0 140px rgba(100,100,100,0.5); }
    100% { transform: perspective(700px) scale(0.8)  translateY(8px); opacity: 0; box-shadow: none; }
  }
</style>
</head>
<body>

<canvas id="bg-canvas"></canvas>
<div class="noise-overlay"></div>
<div class="vignette"></div>
<div class="comet-container">
  <div class="comet" style="top:15%;left:85%;--cdur:5s;--cdelay:0s"></div>
  <div class="comet" style="top:45%;left:95%;--cdur:7s;--cdelay:2.5s"></div>
  <div class="comet" style="top:70%;left:90%;--cdur:6s;--cdelay:5s"></div>
</div>
<div id="scroll-progress"></div>


<div id="app"></div>
<div class="noise-overlay"></div>
<div class="scanline-overlay"></div>

<!-- Tweaks Panel -->
<script type="text/babel">

// tweaks-panel.jsx
// Reusable Tweaks shell + form-control helpers.
//
// Owns the host protocol (listens for __activate_edit_mode / __deactivate_edit_mode,
// posts __edit_mode_available / __edit_mode_set_keys / __edit_mode_dismissed) so
// individual prototypes don't re-roll it. Ships a consistent set of controls so you
// don't hand-draw <input type="range">, segmented radios, steppers, etc.
//
// Usage (in an HTML file that loads React + Babel):
//
//   const TWEAK_DEFAULTS = /*EDITMODE-BEGIN*/{
//     "primaryColor": "#D97757",
//     "fontSize": 16,
//     "density": "regular",
//     "dark": false
//   }/*EDITMODE-END*/;
//
//   function App() {
//     const [t, setTweak] = useTweaks(TWEAK_DEFAULTS);
//     return (
//       <div style={{ fontSize: t.fontSize, color: t.primaryColor }}>
//         Hello
//         <TweaksPanel>
//           <TweakSection label="Typography" />
//           <TweakSlider label="Font size" value={t.fontSize} min={10} max={32} unit="px"
//                        onChange={(v) => setTweak('fontSize', v)} />
//           <TweakRadio  label="Density" value={t.density}
//                        options={['compact', 'regular', 'comfy']}
//                        onChange={(v) => setTweak('density', v)} />
//           <TweakSection label="Theme" />
//           <TweakColor  label="Primary" value={t.primaryColor}
//                        onChange={(v) => setTweak('primaryColor', v)} />
//           <TweakToggle label="Dark mode" value={t.dark}
//                        onChange={(v) => setTweak('dark', v)} />
//         </TweaksPanel>
//       </div>
//     );
//   }
//
// ─────────────────────────────────────────────────────────────────────────────

const __TWEAKS_STYLE = `
  .twk-panel{position:fixed;right:16px;bottom:16px;z-index:2147483646;width:280px;
    max-height:calc(100vh - 32px);display:flex;flex-direction:column;
    background:rgba(250,249,247,.78);color:#29261b;
    -webkit-backdrop-filter:blur(24px) saturate(160%);backdrop-filter:blur(24px) saturate(160%);
    border:.5px solid rgba(255,255,255,.6);border-radius:14px;
    box-shadow:0 1px 0 rgba(255,255,255,.5) inset,0 12px 40px rgba(0,0,0,.18);
    font:11.5px/1.4 ui-sans-serif,system-ui,-apple-system,sans-serif;overflow:hidden}
  .twk-hd{display:flex;align-items:center;justify-content:space-between;
    padding:10px 8px 10px 14px;cursor:move;user-select:none}
  .twk-hd b{font-size:12px;font-weight:600;letter-spacing:.01em}
  .twk-x{appearance:none;border:0;background:transparent;color:rgba(41,38,27,.55);
    width:22px;height:22px;border-radius:6px;cursor:default;font-size:13px;line-height:1}
  .twk-x:hover{background:rgba(0,0,0,.06);color:#29261b}
  .twk-body{padding:2px 14px 14px;display:flex;flex-direction:column;gap:10px;
    overflow-y:auto;overflow-x:hidden;min-height:0;
    scrollbar-width:thin;scrollbar-color:rgba(0,0,0,.15) transparent}
  .twk-body::-webkit-scrollbar{width:8px}
  .twk-body::-webkit-scrollbar-track{background:transparent;margin:2px}
  .twk-body::-webkit-scrollbar-thumb{background:rgba(0,0,0,.15);border-radius:4px;
    border:2px solid transparent;background-clip:content-box}
  .twk-body::-webkit-scrollbar-thumb:hover{background:rgba(0,0,0,.25);
    border:2px solid transparent;background-clip:content-box}
  .twk-row{display:flex;flex-direction:column;gap:5px}
  .twk-row-h{flex-direction:row;align-items:center;justify-content:space-between;gap:10px}
  .twk-lbl{display:flex;justify-content:space-between;align-items:baseline;
    color:rgba(41,38,27,.72)}
  .twk-lbl>span:first-child{font-weight:500}
  .twk-val{color:rgba(41,38,27,.5);font-variant-numeric:tabular-nums}

  .twk-sect{font-size:10px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;
    color:rgba(41,38,27,.45);padding:10px 0 0}
  .twk-sect:first-child{padding-top:0}

  .twk-field{appearance:none;width:100%;height:26px;padding:0 8px;
    border:.5px solid rgba(0,0,0,.1);border-radius:7px;
    background:rgba(255,255,255,.6);color:inherit;font:inherit;outline:none}
  .twk-field:focus{border-color:rgba(0,0,0,.25);background:rgba(255,255,255,.85)}
  select.twk-field{padding-right:22px;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path fill='rgba(0,0,0,.5)' d='M0 0h10L5 6z'/></svg>");
    background-repeat:no-repeat;background-position:right 8px center}

  .twk-slider{appearance:none;-webkit-appearance:none;width:100%;height:4px;margin:6px 0;
    border-radius:999px;background:rgba(0,0,0,.12);outline:none}
  .twk-slider::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;
    width:14px;height:14px;border-radius:50%;background:#fff;
    border:.5px solid rgba(0,0,0,.12);box-shadow:0 1px 3px rgba(0,0,0,.2);cursor:default}
  .twk-slider::-moz-range-thumb{width:14px;height:14px;border-radius:50%;
    background:#fff;border:.5px solid rgba(0,0,0,.12);box-shadow:0 1px 3px rgba(0,0,0,.2);cursor:default}

  .twk-seg{position:relative;display:flex;padding:2px;border-radius:8px;
    background:rgba(0,0,0,.06);user-select:none}
  .twk-seg-thumb{position:absolute;top:2px;bottom:2px;border-radius:6px;
    background:rgba(255,255,255,.9);box-shadow:0 1px 2px rgba(0,0,0,.12);
    transition:left .15s cubic-bezier(.3,.7,.4,1),width .15s}
  .twk-seg.dragging .twk-seg-thumb{transition:none}
  .twk-seg button{appearance:none;position:relative;z-index:1;flex:1;border:0;
    background:transparent;color:inherit;font:inherit;font-weight:500;min-height:22px;
    border-radius:6px;cursor:default;padding:4px 6px;line-height:1.2;
    overflow-wrap:anywhere}

  .twk-toggle{position:relative;width:32px;height:18px;border:0;border-radius:999px;
    background:rgba(0,0,0,.15);transition:background .15s;cursor:default;padding:0}
  .twk-toggle[data-on="1"]{background:#34c759}
  .twk-toggle i{position:absolute;top:2px;left:2px;width:14px;height:14px;border-radius:50%;
    background:#fff;box-shadow:0 1px 2px rgba(0,0,0,.25);transition:transform .15s}
  .twk-toggle[data-on="1"] i{transform:translateX(14px)}

  .twk-num{display:flex;align-items:center;height:26px;padding:0 0 0 8px;
    border:.5px solid rgba(0,0,0,.1);border-radius:7px;background:rgba(255,255,255,.6)}
  .twk-num-lbl{font-weight:500;color:rgba(41,38,27,.6);cursor:ew-resize;
    user-select:none;padding-right:8px}
  .twk-num input{flex:1;min-width:0;height:100%;border:0;background:transparent;
    font:inherit;font-variant-numeric:tabular-nums;text-align:right;padding:0 8px 0 0;
    outline:none;color:inherit;-moz-appearance:textfield}
  .twk-num input::-webkit-inner-spin-button,.twk-num input::-webkit-outer-spin-button{
    -webkit-appearance:none;margin:0}
  .twk-num-unit{padding-right:8px;color:rgba(41,38,27,.45)}

  .twk-btn{appearance:none;height:26px;padding:0 12px;border:0;border-radius:7px;
    background:rgba(0,0,0,.78);color:#fff;font:inherit;font-weight:500;cursor:default}
  .twk-btn:hover{background:rgba(0,0,0,.88)}
  .twk-btn.secondary{background:rgba(0,0,0,.06);color:inherit}
  .twk-btn.secondary:hover{background:rgba(0,0,0,.1)}

  .twk-swatch{appearance:none;-webkit-appearance:none;width:56px;height:22px;
    border:.5px solid rgba(0,0,0,.1);border-radius:6px;padding:0;cursor:default;
    background:transparent;flex-shrink:0}
  .twk-swatch::-webkit-color-swatch-wrapper{padding:0}
  .twk-swatch::-webkit-color-swatch{border:0;border-radius:5.5px}
  .twk-swatch::-moz-color-swatch{border:0;border-radius:5.5px}
`;

// ── useTweaks ───────────────────────────────────────────────────────────────
// Single source of truth for tweak values. setTweak persists via the host
// (__edit_mode_set_keys → host rewrites the EDITMODE block on disk).
function useTweaks(defaults) {
  const [values, setValues] = React.useState(defaults);
  // Accepts either setTweak('key', value) or setTweak({ key: value, ... }) so a
  // useState-style call doesn't write a "[object Object]" key into the persisted
  // JSON block.
  const setTweak = React.useCallback((keyOrEdits, val) => {
    const edits = typeof keyOrEdits === 'object' && keyOrEdits !== null
      ? keyOrEdits : { [keyOrEdits]: val };
    setValues((prev) => ({ ...prev, ...edits }));
    window.parent.postMessage({ type: '__edit_mode_set_keys', edits }, '*');
  }, []);
  return [values, setTweak];
}

// ── TweaksPanel ─────────────────────────────────────────────────────────────
// Floating shell. Registers the protocol listener BEFORE announcing
// availability — if the announce ran first, the host's activate could land
// before our handler exists and the toolbar toggle would silently no-op.
// The close button posts __edit_mode_dismissed so the host's toolbar toggle
// flips off in lockstep; the host echoes __deactivate_edit_mode back which
// is what actually hides the panel.
function TweaksPanel({ title = 'Tweaks', children }) {
  const [open, setOpen] = React.useState(false);
  const dragRef = React.useRef(null);
  const offsetRef = React.useRef({ x: 16, y: 16 });
  const PAD = 16;

  const clampToViewport = React.useCallback(() => {
    const panel = dragRef.current;
    if (!panel) return;
    const w = panel.offsetWidth, h = panel.offsetHeight;
    const maxRight = Math.max(PAD, window.innerWidth - w - PAD);
    const maxBottom = Math.max(PAD, window.innerHeight - h - PAD);
    offsetRef.current = {
      x: Math.min(maxRight, Math.max(PAD, offsetRef.current.x)),
      y: Math.min(maxBottom, Math.max(PAD, offsetRef.current.y)),
    };
    panel.style.right = offsetRef.current.x + 'px';
    panel.style.bottom = offsetRef.current.y + 'px';
  }, []);

  React.useEffect(() => {
    if (!open) return;
    clampToViewport();
    if (typeof ResizeObserver === 'undefined') {
      window.addEventListener('resize', clampToViewport);
      return () => window.removeEventListener('resize', clampToViewport);
    }
    const ro = new ResizeObserver(clampToViewport);
    ro.observe(document.documentElement);
    return () => ro.disconnect();
  }, [open, clampToViewport]);

  React.useEffect(() => {
    const onMsg = (e) => {
      const t = e?.data?.type;
      if (t === '__activate_edit_mode') setOpen(true);
      else if (t === '__deactivate_edit_mode') setOpen(false);
    };
    window.addEventListener('message', onMsg);
    window.parent.postMessage({ type: '__edit_mode_available' }, '*');
    return () => window.removeEventListener('message', onMsg);
  }, []);

  const dismiss = () => {
    setOpen(false);
    window.parent.postMessage({ type: '__edit_mode_dismissed' }, '*');
  };

  const onDragStart = (e) => {
    const panel = dragRef.current;
    if (!panel) return;
    const r = panel.getBoundingClientRect();
    const sx = e.clientX, sy = e.clientY;
    const startRight = window.innerWidth - r.right;
    const startBottom = window.innerHeight - r.bottom;
    const move = (ev) => {
      offsetRef.current = {
        x: startRight - (ev.clientX - sx),
        y: startBottom - (ev.clientY - sy),
      };
      clampToViewport();
    };
    const up = () => {
      window.removeEventListener('mousemove', move);
      window.removeEventListener('mouseup', up);
    };
    window.addEventListener('mousemove', move);
    window.addEventListener('mouseup', up);
  };

  if (!open) return null;
  return (
    <>
      <style>{__TWEAKS_STYLE}</style>
      <div ref={dragRef} className="twk-panel" data-noncommentable=""
           style={{ right: offsetRef.current.x, bottom: offsetRef.current.y }}>
        <div className="twk-hd" onMouseDown={onDragStart}>
          <b>{title}</b>
          <button className="twk-x" aria-label="Close tweaks"
                  onMouseDown={(e) => e.stopPropagation()}
                  onClick={dismiss}>✕</button>
        </div>
        <div className="twk-body">{children}</div>
      </div>
    </>
  );
}

// ── Layout helpers ──────────────────────────────────────────────────────────

function TweakSection({ label, children }) {
  return (
    <>
      <div className="twk-sect">{label}</div>
      {children}
    </>
  );
}

function TweakRow({ label, value, children, inline = false }) {
  return (
    <div className={inline ? 'twk-row twk-row-h' : 'twk-row'}>
      <div className="twk-lbl">
        <span>{label}</span>
        {value != null && <span className="twk-val">{value}</span>}
      </div>
      {children}
    </div>
  );
}

// ── Controls ────────────────────────────────────────────────────────────────

function TweakSlider({ label, value, min = 0, max = 100, step = 1, unit = '', onChange }) {
  return (
    <TweakRow label={label} value={`${value}${unit}`}>
      <input type="range" className="twk-slider" min={min} max={max} step={step}
             value={value} onChange={(e) => onChange(Number(e.target.value))} />
    </TweakRow>
  );
}

function TweakToggle({ label, value, onChange }) {
  return (
    <div className="twk-row twk-row-h">
      <div className="twk-lbl"><span>{label}</span></div>
      <button type="button" className="twk-toggle" data-on={value ? '1' : '0'}
              role="switch" aria-checked={!!value}
              onClick={() => onChange(!value)}><i /></button>
    </div>
  );
}

function TweakRadio({ label, value, options, onChange }) {
  const trackRef = React.useRef(null);
  const [dragging, setDragging] = React.useState(false);
  const opts = options.map((o) => (typeof o === 'object' ? o : { value: o, label: o }));
  const idx = Math.max(0, opts.findIndex((o) => o.value === value));
  const n = opts.length;

  // The active value is read by pointer-move handlers attached for the lifetime
  // of a drag — ref it so a stale closure doesn't fire onChange for every move.
  const valueRef = React.useRef(value);
  valueRef.current = value;

  const segAt = (clientX) => {
    const r = trackRef.current.getBoundingClientRect();
    const inner = r.width - 4;
    const i = Math.floor(((clientX - r.left - 2) / inner) * n);
    return opts[Math.max(0, Math.min(n - 1, i))].value;
  };

  const onPointerDown = (e) => {
    setDragging(true);
    const v0 = segAt(e.clientX);
    if (v0 !== valueRef.current) onChange(v0);
    const move = (ev) => {
      if (!trackRef.current) return;
      const v = segAt(ev.clientX);
      if (v !== valueRef.current) onChange(v);
    };
    const up = () => {
      setDragging(false);
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', up);
    };
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
  };

  return (
    <TweakRow label={label}>
      <div ref={trackRef} role="radiogroup" onPointerDown={onPointerDown}
           className={dragging ? 'twk-seg dragging' : 'twk-seg'}>
        <div className="twk-seg-thumb"
             style={{ left: `calc(2px + ${idx} * (100% - 4px) / ${n})`,
                      width: `calc((100% - 4px) / ${n})` }} />
        {opts.map((o) => (
          <button key={o.value} type="button" role="radio" aria-checked={o.value === value}>
            {o.label}
          </button>
        ))}
      </div>
    </TweakRow>
  );
}

function TweakSelect({ label, value, options, onChange }) {
  return (
    <TweakRow label={label}>
      <select className="twk-field" value={value} onChange={(e) => onChange(e.target.value)}>
        {options.map((o) => {
          const v = typeof o === 'object' ? o.value : o;
          const l = typeof o === 'object' ? o.label : o;
          return <option key={v} value={v}>{l}</option>;
        })}
      </select>
    </TweakRow>
  );
}

function TweakText({ label, value, placeholder, onChange }) {
  return (
    <TweakRow label={label}>
      <input className="twk-field" type="text" value={value} placeholder={placeholder}
             onChange={(e) => onChange(e.target.value)} />
    </TweakRow>
  );
}

function TweakNumber({ label, value, min, max, step = 1, unit = '', onChange }) {
  const clamp = (n) => {
    if (min != null && n < min) return min;
    if (max != null && n > max) return max;
    return n;
  };
  const startRef = React.useRef({ x: 0, val: 0 });
  const onScrubStart = (e) => {
    e.preventDefault();
    startRef.current = { x: e.clientX, val: value };
    const decimals = (String(step).split('.')[1] || '').length;
    const move = (ev) => {
      const dx = ev.clientX - startRef.current.x;
      const raw = startRef.current.val + dx * step;
      const snapped = Math.round(raw / step) * step;
      onChange(clamp(Number(snapped.toFixed(decimals))));
    };
    const up = () => {
      window.removeEventListener('pointermove', move);
      window.removeEventListener('pointerup', up);
    };
    window.addEventListener('pointermove', move);
    window.addEventListener('pointerup', up);
  };
  return (
    <div className="twk-num">
      <span className="twk-num-lbl" onPointerDown={onScrubStart}>{label}</span>
      <input type="number" value={value} min={min} max={max} step={step}
             onChange={(e) => onChange(clamp(Number(e.target.value)))} />
      {unit && <span className="twk-num-unit">{unit}</span>}
    </div>
  );
}

function TweakColor({ label, value, onChange }) {
  return (
    <div className="twk-row twk-row-h">
      <div className="twk-lbl"><span>{label}</span></div>
      <input type="color" className="twk-swatch" value={value}
             onChange={(e) => onChange(e.target.value)} />
    </div>
  );
}

function TweakButton({ label, onClick, secondary = false }) {
  return (
    <button type="button" className={secondary ? 'twk-btn secondary' : 'twk-btn'}
            onClick={onClick}>{label}</button>
  );
}

Object.assign(window, {
  useTweaks, TweaksPanel, TweakSection, TweakRow,
  TweakSlider, TweakToggle, TweakRadio, TweakSelect,
  TweakText, TweakNumber, TweakColor, TweakButton,
});

</script>

<script type="text/babel">
const { useState, useEffect, useRef } = React;

// ── TWEAK DEFAULTS ──
const TWEAK_DEFAULTS = /*EDITMODE-BEGIN*/{
  "accentColor": "#cccccc",
  "particleCount": 30,
  "glitchEnabled": true,
  "dripsEnabled": true,
  "cursorTrailEnabled": true,
  "runesEnabled": true
}/*EDITMODE-END*/;

// ── CANVAS BACKGROUND — LIGHTWEIGHT STARS ──
function initCanvas(color) {
  const canvas = document.getElementById('bg-canvas');
  const ctx = canvas.getContext('2d');
  let W, H, particles = [], animId, lastFrame = 0;

  function resize() {
    W = canvas.width = window.innerWidth;
    H = canvas.height = window.innerHeight;
  }
  resize();
  window.addEventListener('resize', resize);

  function hex2rgb(hex) {
    if (hex.length === 4) {
      const r = parseInt(hex[1]+hex[1],16);
      const g = parseInt(hex[2]+hex[2],16);
      const b = parseInt(hex[3]+hex[3],16);
      return {r,g,b};
    }
    return {
      r: parseInt(hex.slice(1,3),16),
      g: parseInt(hex.slice(3,5),16),
      b: parseInt(hex.slice(5,7),16)
    };
  }

  let colorCache; // cache hex2rgb result
  function makeParticle(count) {
    particles = [];
    colorCache = hex2rgb(color);
    const total = count * 2;

    for (let i = 0; i < total; i++) {
      const isStar = i < count;
      const size = isStar ? Math.random()*2.5+0.8 : Math.random()*0.8+0.2;
      particles.push({
        x: Math.random() * W, y: Math.random() * H,
        vx: (Math.random()-0.5)*(isStar?0.04:0.03),
        vy: (Math.random()-0.5)*(isStar?0.04:0.03),
        r: size,
        baseAlpha: isStar ? Math.random()*0.35+0.15 : Math.random()*0.15+0.04,
        pulse: Math.random()*Math.PI*2,
        pulseSpeed: Math.random()*0.015+0.005,
      });
    }
  }

  function draw(now) {
    // Cap at 30fps
    if (now - lastFrame < 33) { animId = requestAnimationFrame(draw); return; }
    lastFrame = now;

    ctx.clearRect(0,0,W,H);
    const {r:cr,g:cg,b:cb} = colorCache;

    for (let i = 0; i < particles.length; i++) {
      const p = particles[i];
      p.x += p.vx; p.y += p.vy;
      p.pulse += p.pulseSpeed;
      if (p.x < -20) p.x = W+20; else if (p.x > W+20) p.x = -20;
      if (p.y < -20) p.y = H+20; else if (p.y > H+20) p.y = -20;

      const alpha = p.baseAlpha * (0.6 + 0.4*Math.sin(p.pulse));
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
      ctx.fillStyle = `rgba(${cr},${cg},${cb},${alpha})`;
      ctx.fill();
    }

    animId = requestAnimationFrame(draw);
  }

  return { init: makeParticle, start: draw, stop: ()=>cancelAnimationFrame(animId) };
}

// ── SCROLL REVEAL ──
function initReveal() {
  const els = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver(entries=>{
    entries.forEach(e=>{ if(e.isIntersecting) e.target.classList.add('in-view'); });
  }, {threshold:0.12});
  els.forEach(el=>io.observe(el));
}

// ── SIGIL SVG ──
function Sigil({color}) {
  return (
    <svg viewBox="0 0 180 180" fill="none" xmlns="http://www.w3.org/2000/svg" className="hero-sigil" style={{width:180,height:180}}>
      <circle cx="90" cy="90" r="85" stroke={color} strokeWidth="1" strokeDasharray="4 8" opacity="0.5"/>
      <circle cx="90" cy="90" r="70" stroke={color} strokeWidth="0.5" opacity="0.3"/>
      <svg viewBox="0 0 180 180" className="hero-sigil-inner">
        <polygon points="90,20 160,150 20,150" stroke={color} strokeWidth="1" fill="none" opacity="0.4"/>
        <polygon points="90,160 20,30 160,30" stroke={color} strokeWidth="1" fill="none" opacity="0.4"/>
        <circle cx="90" cy="90" r="20" stroke={color} strokeWidth="1" fill="none" opacity="0.6"/>
        <line x1="90" y1="5" x2="90" y2="175" stroke={color} strokeWidth="0.5" opacity="0.2"/>
        <line x1="5" y1="90" x2="175" y2="90" stroke={color} strokeWidth="0.5" opacity="0.2"/>
      </svg>
      <circle cx="90" cy="90" r="4" fill={color} opacity="0.8"/>
    </svg>
  );
}

// ── DRIPS ──
function Drips({color, enabled}) {
  if (!enabled) return null;
  const drips = [
    {left:'8%',h:35,dur:'4s',delay:'0s'},
    {left:'15%',h:55,dur:'6s',delay:'1.2s'},
    {left:'28%',h:28,dur:'3.5s',delay:'0.4s'},
    {left:'41%',h:65,dur:'5s',delay:'2s'},
    {left:'52%',h:42,dur:'4.5s',delay:'0.8s'},
    {left:'63%',h:30,dur:'3s',delay:'1.6s'},
    {left:'75%',h:58,dur:'5.5s',delay:'0.2s'},
    {left:'87%',h:38,dur:'4s',delay:'1s'},
    {left:'94%',h:48,dur:'6s',delay:'2.5s'},
  ];
  return (
    <div className="drip-container">
      {drips.map((d,i)=>(
        <div key={i} className="drip" style={{
          left:d.left,
          '--h':d.h+'px',
          '--dur':d.dur,
          '--delay':d.delay,
          background:`linear-gradient(to bottom, ${color}, transparent)`,
        }}/>
      ))}
    </div>
  );
}

// ── RUNES ──
function Runes({enabled}) {
  if (!enabled) return null;
  const chars = ['✦','⟨','⟩','∞','⌬','⎊','✧','⌖','⧖'];
  const runes = [
    {top:'12%',left:'3%',size:'8rem',dur:'7s',delay:'0s',rot0:'-5deg',rot1:'5deg'},
    {top:'35%',right:'4%',size:'6rem',dur:'9s',delay:'1s',rot0:'3deg',rot1:'-3deg'},
    {top:'60%',left:'2%',size:'10rem',dur:'11s',delay:'2s',rot0:'-8deg',rot1:'2deg'},
    {top:'80%',right:'3%',size:'7rem',dur:'8s',delay:'0.5s',rot0:'5deg',rot1:'-5deg'},
    {top:'20%',right:'8%',size:'5rem',dur:'12s',delay:'1.5s',rot0:'-2deg',rot1:'6deg'},
  ];
  return (
    <>
      {runes.map((r,i)=>(
        <div key={i} className="rune" style={{
          top:r.top, left:r.left||undefined, right:r.right||undefined,
          fontSize:r.size,'--dur':r.dur,'--delay':r.delay,
          '--rot0':r.rot0,'--rot1':r.rot1
        }}>{chars[i%chars.length]}</div>
      ))}
    </>
  );
}

// ── SKILL BAR ──
function SkillBar({name, pct, idx}) {
  const [filled, setFilled] = useState(0);
  const ref = useRef();
  const delay = (idx||0) * 100;
  useEffect(()=>{
    const io = new IntersectionObserver(([e])=>{
      if(e.isIntersecting){
        setTimeout(()=>setFilled(pct), delay);
        io.disconnect();
      }
    },{threshold:0.25});
    if(ref.current) io.observe(ref.current);
    return ()=>io.disconnect();
  },[pct, delay]);
  return (
    <li className="skill-item" ref={ref}>
      <span>{name}</span>
      <div style={{display:'flex',alignItems:'center',gap:'0.4rem'}}>
        <div className="skill-bar-track">
          <div className="skill-bar-fill" style={{'--fill':filled/100}}></div>
        </div>
        <span className="skill-pct">{Math.round(filled)}%</span>
      </div>
    </li>
  );
}

