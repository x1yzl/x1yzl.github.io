          <span></span>
          <span></span>
        </button>
      </nav>

      {/* HERO */}
      <section id="hero">
        <Runes enabled={tweaks.runesEnabled}/>
        <div className="hero-particles">
          <div className="hero-particle" style={{top:'20%',left:'10%','--ps':'3px','--pdur':'7s','--pdelay':'0s','--px':'120px','--py':'-80px','--pop':'0.3'}}></div>
          <div className="hero-particle" style={{top:'40%',right:'15%','--ps':'2px','--pdur':'9s','--pdelay':'1.5s','--px':'-90px','--py':'-120px','--pop':'0.25'}}></div>
          <div className="hero-particle" style={{top:'70%',left:'20%','--ps':'4px','--pdur':'8s','--pdelay':'3s','--px':'80px','--py':'-60px','--pop':'0.35','--pblur':'1px'}}></div>
          <div className="hero-particle" style={{top:'30%',right:'8%','--ps':'1.5px','--pdur':'11s','--pdelay':'2s','--px':'-150px','--py':'50px','--pop':'0.2'}}></div>
          <div className="hero-particle" style={{top:'80%',right:'25%','--ps':'2.5px','--pdur':'6s','--pdelay':'4s','--px':'60px','--py':'-100px','--pop':'0.3'}}></div>
        </div>
        <div className="hero-aura"></div>
        <div className="hero-aura hero-aura-2"></div>
        <div className="hero-aura hero-aura-3"></div>
        <Sigil color={accent}/>
        <GothicKatana/>
        <div className="hero-eyeline">◈ building things since 2020 ◈</div>
        <h1 className="hero-name">
          <span
            className={tweaks.glitchEnabled ? "glitch-text glitch" : "glitch-text"}
