// ── SHOW MORE BUTTON ──
function ShowMoreBtn() {
  const [exiting, setExiting] = React.useState(false);
  const handle = (e) => {
    e.preventDefault();
    if (exiting) return;
    setExiting(true);
    setTimeout(() => {
      window.open('https://github.com/x1yzl/', '_blank', 'noopener,noreferrer');
      setTimeout(() => setExiting(false), 150);
    }, 480);
  };
  return (
    <div className="show-more-wrap reveal">
      <button
        className={'btn-show-more' + (exiting ? ' exiting' : '')}
        onClick={handle}
      >
        <span className="sm-icon">◈</span>
        Show more
        <span className="sm-arrow">↗</span>
      </button>
    </div>
  );
}

